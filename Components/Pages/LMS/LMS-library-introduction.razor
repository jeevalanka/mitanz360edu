        new("Student Resources", "fa-solid fa-user-graduate", "Publish learner-ready material, revision packs, FAQs, and supporting resources for self-study."),
        new("Reports & Analytics", "fa-solid fa-chart-line", "Track what is viewed, searched, reused, or trending to improve the quality of learning content."),
        new("Enterprise Security", "fa-solid fa-shield-halved", "Preserve governance using role-based permissions, retention-aware deletion, and audit-ready operations."),
