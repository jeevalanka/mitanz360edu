                            <RadzenCard class="rz-surface-card capability-card h-100">
                                <div class="cap-icon"><i class="@item.Icon" aria-hidden="true"></i></div>
                                <h3 class="cap-title">@item.Title</h3>
                                <p class="cap-copy mb-0">@item.Description</p>
                            </RadzenCard>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section class="section-gap">
            <div class="container-xxl">
                <div class="row g-4 align-items-stretch">
                    <div class="col-12 col-lg-6">
                        <RadzenCard class="rz-surface-card list-panel h-100">
                            <span class="eyebrow">Best Practices</span>
                            <h2 class="section-title small-title">Operational checklist</h2>
                            <ul class="practice-list mb-0">
                                @foreach (var bp in BestPractices)
                                {
                                    <li><i class="fa-solid fa-circle-check" aria-hidden="true"></i><span>@bp</span></li>
                                }
                            </ul>
                        </RadzenCard>
                    </div>
                    <div id="quick-start" class="col-12 col-lg-6">
                        <RadzenCard class="rz-surface-card list-panel h-100">
                            <span class="eyebrow">Quick Start</span>
