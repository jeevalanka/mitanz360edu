@page "/courses"
@layout MainLayout_NoRightPan
@attribute [Authorize(Roles = "Admin,SysAdmin,Trainer,Student")]

@using MITANZ360Edu.Web.Models
@using MITANZ360Edu.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using Radzen

@inject DialogService DialogService
@inject NavigationManager Nav
@inject SharePointService SharePointService

<h3 class="page-title">Courses</h3>

<AuthorizeView Roles="Admin,SysAdmin">
    <Authorized>
        <RadzenButton Text="Add Course"
                      Icon="add_circle"
                      Class="btn-add"
                      ButtonStyle="ButtonStyle.Primary"
                      Click="@(() => Nav.NavigateTo("/courses/edit/0"))" />
    </Authorized>
</AuthorizeView>

@if (isLoading)
{
    <p class="loading">Loading courses...</p>
}
else if (courses.Count == 0)
{
    <p class="loading">No courses available.</p>
}
else
{
    <div class="card-grid">
        @foreach (var c in courses)
        {
            <div class="course-card glass">

                <!-- IMAGE -->
                <img src="@GetImageUrl(c.ImageUrl)"
                     class="course-image"
                     onerror="this.onerror=null;this.src='/Images/Courses/AI-Edu.png';" />

                <div class="course-body">

                    <!-- TITLE -->
                    <h5>@(string.IsNullOrWhiteSpace(c.Title) ? "Untitled Course" : c.Title)</h5>

                    <!-- CATEGORY -->
                    <span class="tag">
                        @(!string.IsNullOrWhiteSpace(c.CourseCategory) ? c.CourseCategory : "General")
                    </span>

                    <!-- DETAILS -->
                    <div class="course-details">
                        <div><strong>ID:</strong> @c.Id</div>
                        <div><strong>Code:</strong> @c.CourseCode</div>
                        <div><strong>Level:</strong> @c.Level</div>
                        <div><strong>Delivery:</strong> @c.DeliveryMode</div>
                        <div><strong>Credits:</strong> @(c.CreditValue?.ToString("0") ?? "0")</div>
                        <div><strong>Duration:</strong> @(c.DurationMinutes?.ToString("0") ?? "0") mins</div>
                    </div>

                    <!-- BUTTONS -->
                    <div class="btn-group">

                        <!-- ✅ IMPORTANT: PASS COURSE NAME -->
                        <RadzenButton Text="Open"
                                      Icon="launch"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Click="@(() => OpenCourseInfo(c))" />

                        <!-- ✅ same fix here -->
                        <RadzenButton Text="Models"
                                      Icon="dashboard"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Secondary"
                                      Click="@(() => OpenCourse(c))" />

                        <AuthorizeView Roles="Admin,SysAdmin">
                            <Authorized>

                                <RadzenButton Text="Edit"
                                              Icon="edit"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Warning"
                                              Click="@(() => Nav.NavigateTo($"/courses/edit/{c.Id}"))" />

                                <RadzenButton Text="Clone"
                                              Icon="content_copy"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Info"
                                              Click="@(() => ConfirmClone(c.Id, c.Title))" />  

                                <RadzenButton Text="Delete"
                                              Icon="delete"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Click="@(() => ConfirmDelete(c.Id, c.Title))" />
                            </Authorized>

                        </AuthorizeView>

                    </div>
                </div>
            </div>
        }
    </div>
}

@code {

    private List<CourseModel> courses = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            courses = (await SharePointService.GetCoursesAsync())?.ToList() ?? new();
        }
        finally
        {
            isLoading = false;
        }
    }

    // ✅ Navigate to Course Information Page by CourseId only
    private void OpenCourseInfo(CourseModel course)
    {
        if (course == null) return;

        Nav.NavigateTo($"/course/{course.Id}");
    }

    // ✅ ✅ ✅ FINAL FIX — SINGLE SOURCE OF TRUTH
    private void OpenCourse(CourseModel course)
    {
        if (course == null || string.IsNullOrWhiteSpace(course.FolderId))
            return;

        // ✅ FORCE correct display name (fallback logic)
        var displayName = !string.IsNullOrWhiteSpace(course.CourseCode)
            ? course.CourseCode        // ✅ USE THIS (Test001)
            : course.Title ?? "Course";

        var safeName = Uri.EscapeDataString(displayName);

        //Nav.NavigateTo($"/course/{course.FolderId}?name={safeName}");
        Nav.NavigateTo($"/lms-student-cont-viewer/{course.FolderId}");
    }

    private static string GetImageUrl(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
            return "/Images/Courses/AI-Edu.png";

        return imageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? imageUrl
            : $"/Images/Courses/{imageUrl}";
    }

    private async Task ConfirmDelete(int courseId, string? title)
    {
        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to delete '{title ?? "this course"}'?",
            "Confirm Delete",
            new ConfirmOptions
            {
                OkButtonText = "Yes, Delete",
                CancelButtonText = "Cancel"
            });

        if (confirmed != true)
            return;

        try
        {
            await SharePointService.DeleteCourseAsync(courseId);

            // ✅ Update UI immediately
            courses = courses.Where(c => c.Id != courseId).ToList();

            // ✅ Optional success message (recommended)
            await DialogService.Alert("Course deleted successfully.", "Success");
        }
        catch (Exception ex)
        {
            await DialogService.Alert(ex.Message, "Delete Failed");
        }
    }
    private async Task ConfirmClone(int courseId, string? title)
    {
        var original = await SharePointService.GetCourseByIdAsync(courseId);

        if (original == null)
        {
            await DialogService.Alert("Course not found", "Error");
            return;
        }

        var clone = new CourseModel
        {
            Title = original.Title + " (Copy)",
            CourseCode = original.CourseCode + "-COPY",
            CourseCategory = original.CourseCategory,
            CourseType = original.CourseType,
            Level = original.Level
        };

        var newId = await SharePointService.CreateCourseAsync(clone);

        Nav.NavigateTo($"/courses/edit/{newId}");
    }
}

<style>

    /* =====================================================
           PAGE
           ===================================================== */

    .page-title {
        margin-bottom: 12px;
        font-weight: 700;
    }

    .loading {
        color: #64748b;
    }

    .btn-add {
        margin-bottom: 18px;
    }

    /* =====================================================
           CARD GRID
           ===================================================== */

    .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
    }

    /* =====================================================
           CARD
           ===================================================== */

    .course-card {
        border-radius: 18px;
        overflow: hidden;
        transition: transform 220ms ease, box-shadow 220ms ease;
    }

        .course-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
        }

    /* =====================================================
           GLASS EFFECT
           ===================================================== */

    .glass {
        background: rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.35);
        transition: background 220ms ease, backdrop-filter 220ms ease, border-color 220ms ease;
    }

    .course-card:hover.glass {
        background: rgba(255, 255, 255, 0.82);
        backdrop-filter: blur(18px);
        border-color: rgba(255, 255, 255, 0.55);
    }

    /* =====================================================
           IMAGE
           ===================================================== */

    .course-image {
        width: 100%;
        height: 200px;
        object-fit: cover;
        transition: transform 300ms ease;
    }

    .course-card:hover .course-image {
        transform: scale(1.04);
    }

    /* =====================================================
           BODY
           ===================================================== */

    .course-body {
        padding: 16px;
    }

    /* =====================================================
           TAG
           ===================================================== */

    .tag {
        display: inline-block;
        font-size: 12px;
        padding: 4px 10px;
        border-radius: 999px;
        background: #e0f2fe;
        color: #0369a1;
        margin-bottom: 12px;
    }

    /* =====================================================
           DETAILS
           ===================================================== */

    .course-details {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 14px;
        color: #334155;
        margin-top: 14px;
    }

    /* =====================================================
           BUTTON GROUP
           ===================================================== */

    .btn-group {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 18px;
    }

    /* =====================================================
           ACCESSIBILITY
           ===================================================== */

    @@media (prefers-reduced-motion: reduce) {

        .course-card,
        .glass,
        .course-image {
            transition: none;
        }
    }

</style>
