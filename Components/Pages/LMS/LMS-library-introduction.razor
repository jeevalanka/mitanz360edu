        new("Microsoft Graph context", "Bring profile-aware discovery, connected search, and Microsoft 365-aligned intelligence into the experience.", "fa-solid fa-sitemap")
    ];

    private readonly IReadOnlyList<SectionCard> Capabilities =
    [
        new("Learning Resources", "fa-solid fa-book", "Present curated notes, guides, references, templates, and multimedia aligned to each learning outcome."),
        new("Course Libraries", "fa-solid fa-folder-tree", "Organize content using consistent academy, course, module, and lesson-level information architecture."),
