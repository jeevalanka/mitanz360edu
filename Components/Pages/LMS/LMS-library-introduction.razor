    private readonly IReadOnlyList<TimelineStep> Journey =
    [
        new("01", "Browse Library", "Start with the main landing experience to see featured courses, learning paths, and newly published resources."),
        new("02", "Expand Folder", "Move through academy, department, course, module, and lesson folders using the structured content tree."),
        new("03", "Choose Module", "Select the exact module or learning unit that supports the immediate learning objective."),
        new("04", "Open Document", "Launch a note, presentation, spreadsheet, PDF, video, image, or code sample from the library."),
        new("05", "Preview Content", "Confirm relevance by previewing the file, reading metadata, and identifying the latest approved version."),
        new("06", "Study & Practice", "Read, watch, practice, review, and download approved supporting resources where policy allows."),
