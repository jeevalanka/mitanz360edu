@page "/lms-crud-edit/{Id}/{FolderId}"
@layout Lib_Cont_Layout

@using MITANZ360Edu.Web.Services
@using MITANZ360Edu.Web.Services.Automation
@using Radzen
@using Radzen.Blazor
@using System.Text.Json
@using System.Text.Json.Nodes
@using System.Text.RegularExpressions;
@using HtmlAgilityPack;
@using System.Net;

@inject SharePointService SharePointService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject IJSRuntime JS
@inject Radzen.DialogService DialogService
@inject JsonLookupDataService JsonLookupDataService
@inject AutomationService AutomationService

<PageTitle>LMS Content Edit</PageTitle>

<!-- ===================================================== -->
<!-- PAGE -->
<!-- ===================================================== -->

<div style="
    min-height:100vh;
    padding:28px;
    background:
    linear-gradient(
    135deg,
    #f3f6fb,
    #eef3f8);">

    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <RadzenCard Style="
        border-radius:30px;
        padding:10px;
        margin-bottom:14px;
        background:
        linear-gradient(
        135deg,
        blue,
        #0078D4,
        black);
        color:white;
        box-shadow:
        0 10px 20px rgba(0,0,0,0.16);">

        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.SpaceBetween">

            <div>
                <RadzenText TextStyle="TextStyle.H6" Style="font-weight:700; color:white;">
                    LMS Content Editor
                </RadzenText>
            </div>

            <RadzenButton Icon="arrow_back"
                          Text="Back"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@BackToLibrary"
                          Style="
            border-radius:16px;
            height:18px;
            padding-left:10px;
            padding-right:20px;
            font-weight:800;" />

        </RadzenStack>

    </RadzenCard>

    <!-- ================================================= -->
    <!-- MAIN GRID -->
    <!-- ================================================= -->

    <RadzenRow Gap="1rem">

        <!-- ============================================= -->
        <!-- LEFT -->
        <!-- ============================================= -->

        <RadzenColumn Size="8">

            <!-- GENERAL -->

            <RadzenCard Style="@GlassCardStyle">
                <RadzenStack Gap="1.25rem">
                    <RadzenText TextStyle="TextStyle.H5" Style="@SectionHeaderStyle">
                        General Information
                    </RadzenText>

                    <div class="lms-inline-fields">
                        <RadzenTextBox @bind-Value="Model.ContentId"
                                       Placeholder="Content ID"
                                       Style="width:50%;"
                                       ReadOnly="true"
                                       Title="System generated enterprise content identifier." />

                        <RadzenTextBox @bind-Value="Model.CourseId"
                                       Placeholder="Course ID"
                                       Style="width:50%;"
                                       ReadOnly="true"
                                       Title="Associated LMS course identifier." />
                    </div>

                    <RadzenTextBox @bind-Value="Model.Title"
                                   Placeholder="Title"
                                   Style="@InputStyle"
                                   Title="Main learning content title displayed in the LMS." />

                    <RadzenTextArea @bind-Value="Model.Description"
                                    Placeholder="Description"
                                    Rows="5"
                                    Style="@InputStyle"
                                    Title="Detailed summary or overview of the learning content." />

                </RadzenStack>
            </RadzenCard>

            <!-- EXTENDED METADATA -->

            <RadzenCard Style="@GlassCardStyle">
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H5"
                                Style="@SectionHeaderStyle">
                        Extended Metadata
                    </RadzenText>

                    <RadzenTextArea @bind-Value="Model.MetadataJson"
                                    Rows="10"
                                    Style="@InputStyle"
                                    Title="Structured metadata information stored in JSON format." />
                </RadzenStack>
            </RadzenCard>

            <!-- AI -->

            <RadzenCard Style="@AiCardStyle">
                <RadzenStack Gap="1rem">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem"AlignItems="AlignItems.Center">
                        <RadzenIcon Icon="psychology" Style=" font-size:28px; color:#0078D4;" />
                        <RadzenText TextStyle="TextStyle.H5" Style="@SectionHeaderStyle">
                            AI Intelligence Feed
                        </RadzenText>

                        <RadzenButton Icon="psychology"
                                      Text="Generate AI Feedback"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Click="@GenerateAIFeedbackAsync"
                                      Disabled="@IsAiButtonDisabled"
                                      Busy="@IsLoading"
                                      BusyText="AI Processing..." />

                    </RadzenStack>

                    <RadzenTextArea @bind-Value="Model.AiFeed"
                                    Rows="10"
                                    Style="@InputStyle"
                                    Title="AI-generated summaries, intelligence insights, or recommendations." />
                </RadzenStack>
            </RadzenCard>

        </RadzenColumn>

        <!-- ============================================= -->
        <!-- RIGHT -->
        <!-- ============================================= -->

        <RadzenColumn Size="4">
            <!-- METADATA -->
            <RadzenCard Style="@GlassCardStyle">

                <RadzenStack Gap="1rem">

                    <RadzenText TextStyle="TextStyle.H5" Style="@SectionHeaderStyle">
                        METADATA
                    </RadzenText>

                    <!-- Select Country -->
                    <RadzenDropDown Data="@Countries"
                                    TValue="string"
                                    TextProperty="Name"
                                    ValueProperty="Code"
                                    @bind-Value="SelectedCountry"
                                    Change="OnCountryChanged"
                                    Placeholder="Select Country"
                                    AllowClear="true"
                                    Style="@InputStyle"
                                    Title="Country associated with this learning content." />
                    <!-- Select Course -->
                    <RadzenDropDown TValue="string"
                                    Data="@Courses"
                                    TextProperty="Title"
                                    ValueProperty="CourseCode"
                                    @bind-Value="Model.CourseId"
                                    Change="@OnCourseChanged"
                                    Placeholder="Select Course"
                                    Style="@InputStyle"
                                    Title="Select the linked LMS course." />

                </RadzenStack>

            </RadzenCard>
            <!-- GOVERNANCE -->
            <RadzenCard Style="@GlassCardStyle">

                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H5"
                                Style="@SectionHeaderStyle">
                        Governance
                    </RadzenText>

                    <!-- CONTENT TYPE -->
                    <RadzenDropDown Data="@ContentTypes"
                                    TValue="string"
                                    @bind-Value="Model.ContentType"
                                    Placeholder="Content Type"
                                    Style="@InputStyle"
                                    Title="Defines the category or type of learning content." />

                    <!-- SOURCE -->
                    <RadzenDropDown Data="@Sources"
                                    TValue="string"
                                    @bind-Value="Model.Source"
                                    Placeholder="Source"
                                    Style="@InputStyle"
                                    Title="Indicates where the content originated from." />

                    <RadzenDropDown Data="@CourseModels"
                                    TValue="string"
                                    @bind-Value="Model.CourseModel"
                                    Placeholder="Select Course Model"
                                    Style="@InputStyle"
                                    Title="Associated learning model or curriculum structure." />

                    <!-- PUBLISHED -->
                    <RadzenCard Style="
                        border-radius:18px;
                        padding:18px;
                        background:
                        rgba(255,255,255,0.55);">

                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.SpaceBetween">

                            <div>
                                <RadzenText TextStyle="TextStyle.Body1">
                                    Published
                                </RadzenText>

                                <RadzenText TextStyle="TextStyle.Caption">
                                    Enable learner visibility
                                </RadzenText>
                            </div>

                            <RadzenSwitch @bind-Value="Model.IsPublished" />

                        </RadzenStack>

                    </RadzenCard>

                    <!-- ARCHIVED -->
                    <RadzenCard Style="
                        border-radius:18px;
                        padding:18px;
                        background:
                        rgba(255,255,255,0.55);">

                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.SpaceBetween">
                            <div>
                                <RadzenText TextStyle="TextStyle.Body1">
                                    Archived
                                </RadzenText>

                                <RadzenText TextStyle="TextStyle.Caption">
                                    Remove from active usage
                                </RadzenText>
                            </div>
                            <RadzenSwitch @bind-Value="Model.IsArchived" />
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>

            </RadzenCard>
            <!-- QUICK INFO -->
            <RadzenCard Style="@GlassCardStyle">

                <RadzenStack Gap="0.75rem">

                    <RadzenText TextStyle="TextStyle.H5"
                                Style="@SectionHeaderStyle">

                        Quick Info

                    </RadzenText>

                    <div>
                        <b>File:</b> @Model.Name
                    </div>

                    <div>
                        <b>Modified:</b> @Model.LastModified?.LocalDateTime.ToString("g")

                    </div>

                    <div>
                        <b>Size:</b>
                        @FormatBytes(Model.Size)
                    </div>

                </RadzenStack>

            </RadzenCard>
        </RadzenColumn>

    </RadzenRow>

    <!-- ================================================= -->
    <!-- STICKY ACTION BAR -->
    <!-- ================================================= -->

    <div style="
        position:sticky;
        bottom:0;
        margin-top:18px;
        padding:10px;
        border-radius:30px;
        background: #d1d5db;
        backdrop-filter:blur(18px);
        box-shadow: 0 10px 30px rgba(0,0,0,1.0);">

        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.End"
                     Gap="0.5rem">

            <RadzenButton Icon="open_in_new"
                          Text="Open Online"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@OpenOnline"
                          Style="@ActionButtonStyle" />

            <RadzenButton ButtonStyle="ButtonStyle.Primary"
                          Icon="save"
                          Text="Save Changes"
                          Click="@SaveAsync"
                          Style="@ActionButtonStyle" />

            <RadzenButton Icon="delete"
                          Text="Delete"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@ConfirmDeleteAsync"
                          Style="@ActionButtonStyle" />

            <RadzenButton ButtonStyle="ButtonStyle.Warning"
                          Icon="close"
                          Text="Cancel"
                          Click="@BackToLibrary"
                          Style="@ActionButtonStyle" />

        </RadzenStack>

    </div>

</div>

@code {

    [Parameter]
    public string Id { get; set; } = string.Empty;
    [Parameter]
    public string FolderId { get; set; } = "root";

    private LibraryItem Model = new();
    private IReadOnlyList<CourseModel> Courses = [];
    private List<JsonLookupDataService.CountryModel> Countries = [];

    private IEnumerable<ContentType> ContentTypes => Enum.GetValues<ContentType>();
    private IEnumerable<SourceType> Sources => Enum.GetValues<SourceType>();
    private IEnumerable<CourseModelType> CourseModels => Enum.GetValues<CourseModelType>();

    private string? SelectedCountry;
    private string? SelectedCurrency;
    private string? SelectedTimezone;
    private bool IsLoading;

    private bool IsAiButtonDisabled =>
    IsLoading ||
    Model?.Name?.ToLower().EndsWith(".jpg") == true ||
    Model?.Name?.ToLower().EndsWith(".jpeg") == true ||
    Model?.Name?.ToLower().EndsWith(".png") == true ||
    Model?.Name?.ToLower().EndsWith(".gif") == true ||
    Model?.Name?.ToLower().EndsWith(".bmp") == true ||
    Model?.Name?.ToLower().EndsWith(".mp4") == true ||
    Model?.Name?.ToLower().EndsWith(".mp3") == true;


    // =====================================================
    // STYLES
    // =====================================================
    private const string GlassCardStyle = @"
        margin-bottom:24px;
        border-radius:24px;
        padding:28px;
        background:
            rgba(255,255,255,0.62);
        backdrop-filter:blur(18px);
        border:1px solid rgba(255,255,255,0.22);
        box-shadow:
            0 10px 30px rgba(0,0,0,0.08);";
    private const string AiCardStyle = @"
        margin-bottom:24px;
        border-radius:24px;
        padding:28px;
        background:
            linear-gradient(
                135deg,
                rgba(0,120,212,0.08),
                rgba(202,80,16,0.08));
        backdrop-filter:blur(18px);
        border:1px solid rgba(255,255,255,0.22);
        box-shadow:
            0 10px 30px rgba(0,0,0,0.08);";
    private const string InputStyle = @"
        width:100%;
        border-radius:16px;";
    private const string SectionHeaderStyle = @"
        font-weight:700;
        color:#004578;";
    private const string ActionButtonStyle = @"
    min-width:120px;
    height:42px;
    border-radius:18px;
    font-weight:600;
    font-size:0.92rem;
    color:black;
    background: linear-gradient( 135deg, rgba(255,255,255,1), rgba(255,255,255,0.02));
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border:1px solid rgba(255,255,255,0.25);
    box-shadow:0 8px 24px rgba(0,0,0,0.18);
    transition: all 0.22s ease;
    letter-spacing:0.3px; ";
    private const string PrimaryButtonStyle = @"
        min-width:220px;
        height:52px;
        border-radius:18px;
        font-weight:700;
        background:
            linear-gradient(
                135deg,
                #0078D4,
                #CA5010);";

    // =====================================================
    // LOAD (RUNS ON EVERY ID CHANGE)
    // =====================================================
    protected override async Task OnParametersSetAsync()
    {
        // -----------------------------------------------------
        // Load Course from SharePoint
        // -----------------------------------------------------
        Courses = await SharePointService.GetCoursesAsync();
        // -----------------------------------------------------
        // Load active countries (Json Country list)
        // -----------------------------------------------------
        Countries = await JsonLookupDataService.GetCountriesAsync();

        // -----------------------------------------------------
        // NEW TRANSACTION
        // -----------------------------------------------------

        if (string.IsNullOrWhiteSpace(Id))
        {
            Model = new LibraryItem
            {
                ContentId = SharePointService.GenerateContentId(),
                IsPublished = true,
                Source = "Internal"
            };

            return;
        }

        // -----------------------------------------------------
        // Resolve LMS Drive
        // -----------------------------------------------------
        var driveId = await SharePointService.GetPublicLmsDriveIdAsync();

        // -----------------------------------------------------
        // Load SharePoint item + metadata
        // -----------------------------------------------------
        var item = await SharePointService.GetItemAsync(driveId, Id);
        if (item == null)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Not Found", "Document not found");
            return;
        }

        // -----------------------------------------------------
        // Bind model
        // -----------------------------------------------------
        Model = item;

        // -----------------------------------------------------
        // ✅ Restore SelectedCountry from MetadataJson
        // -----------------------------------------------------
        if (!string.IsNullOrWhiteSpace(Model.MetadataJson))
        {
            try
            {
                var country =
                    JsonSerializer.Deserialize<CountryLookup>(
                        Model.MetadataJson);

                if (country != null &&
                    !string.IsNullOrWhiteSpace(country.ISOCode))
                {
                    SelectedCountry = country.ISOCode;
                }
            }
            catch (JsonException)
            {
                // Ignore invalid / legacy metadata
                // Do NOT block page rendering
            }
        }
    }

    // =====================================================
    // SAVE
    // =====================================================
    private async Task SaveAsync()
    {
        try
        {
            var driveId =
                await SharePointService.GetPublicLmsDriveIdAsync();

            await SharePointService.UpdateLibraryItemAsync(
                driveId,
                Id,
                Model);

            NotificationService.Notify(
                NotificationSeverity.Success,
                "Success",
                "Content updated successfully.");

            NavigationManager.NavigateTo("/lms-library-introduction");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                "Error",
                ex.Message);
        }
    }

    // =====================================================
    // BACK
    // =====================================================
    private void BackToLibrary()
    {
        NavigationManager.NavigateTo("/lms-library-introduction");
    }

    // =====================================================
    // FORMAT
    // =====================================================
    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0)
            return "0 B";

        string[] sizes =
        [
            "B",
            "KB",
            "MB",
            "GB"
        ];

        var order =
            (int)Math.Log(bytes, 1024);

        return string.Format(
            "{0:0.##} {1}",
            bytes / Math.Pow(1024, order),
            sizes[order]);
    }

    // =====================================================
    // Open Document Online
    // =====================================================
    private async Task OpenOnline()
    {
        if (Model == null || string.IsNullOrWhiteSpace(Model.WebUrl))
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Unavailable",
                "Online preview is not available for this document.");
            return;
        }

        await JS.InvokeVoidAsync(
            "open",
            Model.WebUrl,
            "_blank");
    }

    // =====================================================
    // Delete Selected Content
    // =====================================================
    private async Task DeleteAsync()
    {
        if (Model == null)
            return;

        await SharePointService.DeleteItemAsync(
            Model.DriveId,
            Model.Id);

        NotificationService.Notify(
            NotificationSeverity.Success,
            "Deleted",
            "Content deleted successfully.");

        NavigationManager.NavigateTo("/lms-library");
    }
    private async Task ConfirmDeleteAsync()
    {
        var confirmed = await DialogService.Confirm(
            "Are you sure you want to delete this item?",
            "Confirm Delete",
            new ConfirmOptions
            {
                OkButtonText = "Delete",
                CancelButtonText = "Cancel"
            });

        if (confirmed != true)
            return;

        await DeleteAsync();
    }

    // =====================================================
    // On Change {Country,Course, }
    // =====================================================
    private void OnCountryChanged(object value)
    {
        var isoCode = value?.ToString();
        var selected = Countries.FirstOrDefault(x => x.Code == isoCode);

        if (selected == null) return;

        SelectedCountry = isoCode ?? string.Empty;

        // =====================================================
        // Parse Existing Metadata
        // =====================================================

        Dictionary<string, object> metadata;

        try
        {
            metadata =
                string.IsNullOrWhiteSpace(
                    Model.MetadataJson)
                    ? []
                    : JsonSerializer.Deserialize<
                        Dictionary<string, object>>(
                        Model.MetadataJson) ?? [];
        }
        catch
        {
            metadata = [];
        }

        // =====================================================
        // UPDATE EXISTING VALUES
        // =====================================================

        metadata["CountryCode"] =
            selected.Code;

        metadata["CountryName"] =
            selected.Name;

        // =====================================================
        // SAVE UPDATED METADATA
        // =====================================================

        Model.MetadataJson = JsonSerializer.Serialize( metadata, new JsonSerializerOptions
                {
                    WriteIndented = true
                });
    }
    private void OnCourseChanged(object value)
    {
        var courseCode = value?.ToString();
        var selected = Courses.FirstOrDefault(x => x.CourseCode == courseCode);

        if (selected == null) return;

        // =====================================================
        // UPDATE MODEL
        // =====================================================

        Model.CourseId = selected.CourseCode;

        // =====================================================
        // PARSE EXISTING METADATA
        // =====================================================

        Dictionary<string, object> metadata;

        try
        {
            metadata =
                string.IsNullOrWhiteSpace(
                    Model.MetadataJson)
                    ? []
                    : JsonSerializer.Deserialize<
                        Dictionary<string, object>>(
                        Model.MetadataJson) ?? [];
        }
        catch
        {
            metadata = [];
        }

        // =====================================================
        // UPDATE COURSE METADATA
        // =====================================================

        metadata["CourseId"] = selected.CourseCode;
        metadata["CourseTitle"] = selected.Title;
        metadata["CourseLearningOutcomes"] = selected.LearningOutcomes;
        metadata["CourseDescription"] = selected.Description;

        // =====================================================
        // SAVE UPDATED METADATA
        // =====================================================

        Model.MetadataJson =
            JsonSerializer.Serialize(
                metadata,
                new JsonSerializerOptions
                {
                    WriteIndented = true
                });
    }

    // =====================================================
    //AI output to the UI
    // =====================================================
    private async Task GenerateAIFeedbackAsync()
    {
        if (IsLoading || Model == null || string.IsNullOrWhiteSpace(Model.Id))
        {
            NotificationService.Notify(
                NotificationSeverity.Warning,
                "Unavailable",
                "No content item is loaded.");
            return;
        }

        try
        {
            IsLoading = true;

            NotificationService.Notify(
                NotificationSeverity.Info,
                "AI Processing",
                "AI intelligence generation started.");

            // =====================================================
            // 1️⃣ Parse metadata (SAFE)
            // =====================================================
            var json =
                JsonNode.Parse(Model.MetadataJson ?? "{}")?.AsObject();

            if (json != null)
            {
                if (json["CourseDescription"] != null)
                {
                    json["CourseDescription"] = HtmlToText(json["CourseDescription"]!.ToString());
                }

                if (json["CourseLearningOutcomes"] != null)
                {
                    json["CourseLearningOutcomes"] = HtmlToText(json["CourseLearningOutcomes"]!.ToString());
                }
            }

            var metadata = new Dictionary<string, string>();

            // ✅ STEP 1 — READ JSON AND CLEAN HTML
            if (json != null)
            {
                foreach (var item in json)
                {
                    var value = item.Value?.ToString() ?? "";

                    // ✅ remove HTML
                    value = HtmlToText(value);

                    metadata[item.Key] = value;
                }
            }

            // ✅ STEP 2 — FALLBACK ONLY IF MISSING
            if (!metadata.ContainsKey("CourseTitle") || string.IsNullOrWhiteSpace(metadata["CourseTitle"]))
            {
                metadata["CourseTitle"] = Model.Title ?? "";
            }

            if (!metadata.ContainsKey("CourseDescription") || string.IsNullOrWhiteSpace(metadata["CourseDescription"]))
            {
                metadata["CourseDescription"] = Model.Description ?? "";
            }

            if (!metadata.ContainsKey("CourseLearningOutcomes") || string.IsNullOrWhiteSpace(metadata["CourseLearningOutcomes"]))
            {
                metadata["CourseLearningOutcomes"] = "";
            }

            // =====================================================
            // 2️⃣ Extract content
            // =====================================================
            var extractedContent =
                await SharePointService.ExtractDocumentContentAsync(
                    Model.DriveId,
                    Model.Id);

            if (string.IsNullOrWhiteSpace(extractedContent))
            {

                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Unsupported File",
                    "OCR is not supported. Please upload text-based content.");

                return;
            }

            // =====================================================
            // ✅ RUN AI ENGINE
            // =====================================================
            var aiResult = await AutomationService.GenerateAIFeedbackAsync(
                metadata,
                extractedContent);

            // =====================================================
            // ✅ HANDLE RESULT
            // =====================================================
            if (string.IsNullOrWhiteSpace(aiResult))
            {
                Model.AiFeed = "⚠ AI completed, but returned empty response.";

                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "AI Warning",
                    "AI returned no content.");
            }
            else
            {
                Model.AiFeed = aiResult;

                // ✅ Detect if AI returned failure message
                if (aiResult.Contains("⚠"))
                {
                    NotificationService.Notify(
                        NotificationSeverity.Warning,
                        "AI Warning",
                        "AI validation detected issues.");
                }
                else
                {
                    NotificationService.Notify(
                        NotificationSeverity.Success,
                        "AI Completed",
                        "AI intelligence report generated successfully.");
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                "AI Failed",
                ex.Message);
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    private JsonObject BuildCourseMetadataJson()
    {
        return new JsonObject
        {
            ["CourseId"] = Model.CourseId,
            ["CourseTitle"] = Model.Title,
            ["CourseDescription"] = Model.Description,
            ["CourseLearningOutcomes"] = Model.MetadataJson
        };
    }
    private static string HtmlToText(string? html)
    {
        if (string.IsNullOrWhiteSpace(html))
            return string.Empty;

        var doc = new HtmlDocument();
        doc.LoadHtml(html);

        return WebUtility.HtmlDecode(doc.DocumentNode.InnerText)
                         .Trim();
    }
}
<style>
    .lms-inline-fields {
        display: flex;
        gap: 10px;
        width: 100%;
    }

</style>