    private readonly IReadOnlyList<RoleMatrix> Roles =
    [
        new("System Administrator", "Full platform access, permission control, restorations, audit review, and governance.", true, true, true, true),
        new("Administrator", "Department or platform administration with managed content oversight.", true, true, true, false),
        new("Trainer", "Own course content creation and maintenance within assigned teaching scope.", true, true, true, false),
        new("Student", "Read-only access to assigned and approved learning materials.", false, true, false, false),
        new("Guest", "Restricted visibility to explicitly shared resources only.", false, true, false, false)
    ];

    private readonly IReadOnlyList<SectionCard> ContentTypes =
    [
        new("Word", "fa-solid fa-file-word", "Lecture notes, handbooks, policies, study guides, and trainer instructions."),
        new("Excel", "fa-solid fa-file-excel", "Trackers, datasets, mark sheets, calculators, and practical workbook files."),
        new("PowerPoint", "fa-solid fa-file-powerpoint", "Presentation decks, visual briefings, and learning slide packs."),
        new("PDF", "fa-solid fa-file-pdf", "Published references, controlled course packs, and read-only guidance."),
        new("Images", "fa-solid fa-image", "Screenshots, diagrams, posters, infographics, and visual learning aids."),
        new("Videos", "fa-solid fa-video", "Recorded sessions, walkthroughs, demonstrations, and explainer content."),
        new("ZIP / RAR", "fa-solid fa-file-zipper", "Bundled labs, solution packs, project files, and archive transfers."),
        new("Code & Markdown", "fa-solid fa-code", "Code samples, snippets, scripts, Markdown notes, and technical assets."),
        new("Data Formats", "fa-solid fa-table", "CSV, JSON, XML, and structured files used in labs and integration exercises."),
        new("Microsoft Formats", "fa-solid fa-book", "Visio, Project, OneNote, and related Microsoft productivity assets." )
    ];

    private readonly IReadOnlyList<SectionCard> Integrations =
    [
        new("SharePoint Online", "fa-solid fa-cloud", "Document libraries, metadata, permissions, retention, and versioning as the backbone of the content estate."),
        new("Microsoft Graph", "fa-solid fa-sitemap", "Search enrichment, profile context, file access, and Microsoft 365 connected intelligence."),
        new("Entra ID", "fa-solid fa-id-card", "Secure identity, role-aware access, tenant control, and authentication alignment."),
        new("Azure", "fa-solid fa-server", "Support scalable application services, AI integrations, secure hosting, and enterprise analytics."),
        new("OneDrive", "fa-solid fa-hard-drive", "Governed integration for personal productivity, draft preparation, and controlled collaboration."),
        new("Copilot Ready", "fa-solid fa-lightbulb", "Content structure and metadata that prepare resources for AI grounding and natural-language discovery." )
    ];

    private readonly IReadOnlyList<SectionCard> AiFeatures =
    [
        new("AI Summary", "fa-solid fa-file-lines", "Condense long resources into concise study-ready summaries for faster understanding."),
        new("Learning Recommendations", "fa-solid fa-route", "Suggest next modules, supporting documents, and prerequisite resources based on context."),
        new("Automatic Metadata", "fa-solid fa-tags", "Extract suggested labels, categories, and topic metadata from uploaded content."),
        new("Content Classification", "fa-solid fa-layer-group", "Improve consistency by identifying file type, audience, purpose, and sensitivity."),
        new("Semantic Search", "fa-solid fa-magnifying-glass", "Find conceptually relevant files beyond exact keyword matching."),
        new("AI Translation", "fa-solid fa-language", "Support multilingual understanding where language assistance is enabled." )
    ];

    private readonly IReadOnlyList<string> BestPractices =
    [
        "Use course and module naming standards consistently across the library.",
        "Maintain complete metadata to improve discovery, governance, and reporting.",
        "Version resources instead of replacing files with no traceable history.",
        "Archive outdated packs so learners are not exposed to superseded guidance.",
        "Avoid duplicate uploads that create conflicting sources of truth.",
        "Review permissions regularly to prevent overexposure or content lockout.",
        "Use AI-driven search and summaries to improve content reuse and study efficiency.",
        "Keep learning material current and aligned to outcomes, assessments, and delivery expectations."
    ];

    private readonly IReadOnlyList<MiniInsight> QuickStart =
    [
        new("01 • Browse Course", "Open the correct course collection and start from the approved learning path.", "fa-solid fa-table-cells-large"),
        new("02 • Open Module", "Select the current lesson or module tied to your study objective.", "fa-solid fa-folder-open"),
        new("03 • View Resources", "Review notes, videos, guides, templates, and related files together.", "fa-solid fa-book"),
        new("04 • Complete Labs", "Work through task-based activities and practical exercises.", "fa-solid fa-flask"),
        new("05 • Read Notes", "Use study documents and summaries to consolidate understanding.", "fa-solid fa-file-lines"),
        new("06 • Take Assessment", "Complete quizzes or evidence tasks linked to the module.", "fa-solid fa-clipboard-check"),
        new("07 • Review Feedback", "Use feedback and AI suggestions to improve before moving on.", "fa-solid fa-comments"),
        new("08 • Continue Learning", "Move forward using recent files, favorites, and next-step recommendations.", "fa-solid fa-arrow-right" )
    ];

    private readonly IReadOnlyList<FaqItem> Faqs =
    [
        new("How do I upload learning resources?", "Authorized contributors upload to the correct course or module location, add metadata and tags, set permissions, and publish into the governed library structure."),
        new("Who can edit content?", "Edit rights are role-based. Administrators and System Administrators manage broad scope, while Trainers typically manage content they own or are assigned to maintain."),
        new("How do permissions work?", "Permissions follow role-aware access patterns and can be applied at library, folder, or resource level depending on the governance model."),
        new("Can I preview Office documents before downloading?", "Yes. Supported file types such as Word, Excel, PowerPoint, and PDF can be previewed directly to confirm relevance before action."),
        new("Can deleted files be restored?", "Authorized administrative roles can restore recoverable items where retention and recycle patterns have been configured."),
        new("How does AI help inside the library?", "AI improves search, summarizes long content, recommends related material, suggests metadata, and helps guide study progression." )
    ];

    private record ActionLink(string Title, string Icon, string Target);
    private record MetricCard(string Title, string Value, string Icon, string Description);
    private record MiniInsight(string Title, string Description, string Icon);
    private record SectionCard(string Title, string Icon, string Description);
    private record TimelineStep(string Number, string Title, string Description);
    private record GuideBlock(string Title, string Icon, IReadOnlyList<string> Items);
    private record CrudPanel(string Title, string Icon, IReadOnlyList<string> Items);
    private record RoleMatrix(string Role, string Scope, bool Create, bool Read, bool Update, bool Delete);
    private record FaqItem(string Question, string Answer);
}

<div class="library-shell">
    <header class="page-header-block">
        <div class="container-xxl py-4 py-lg-5">
            <div class="toolbar-surface">
                <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                    <div>
                        <nav aria-label="Breadcrumb" class="mb-2">
                            <ol class="breadcrumb app-breadcrumb mb-0">
                                <li class="breadcrumb-item"><a href="/">Home</a></li>
                                <li class="breadcrumb-item"><a href="/lms-library">Library</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Introduction</li>
                            </ol>
                        </nav>
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <div class="app-mark">
                                <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
                            </div>
                            <div>
                                <h1 class="page-title mb-1">MITANZ360Edu AI Learning Hub</h1>
                                <p class="page-subtitle mb-0">Microsoft-style enterprise introduction and dashboard for the LMS Library Viewer.</p>
                            </div>
                        </div>
                    </div>
                    <div class="toolbar-actions">
                        <a href="#overview" class="top-link"><i class="fa-solid fa-compass me-2"></i>Overview</a>
                        <a href="#journey" class="top-link"><i class="fa-solid fa-route me-2"></i>How to Use</a>
                        <a href="#permissions" class="top-link"><i class="fa-solid fa-shield-halved me-2"></i>Permissions</a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main>
        <section class="hero-section">
            <div class="container-xxl">
                <div class="row g-4 align-items-stretch">
                    <div class="col-12 col-xl-8">
                        <div class="hero-panel h-100">
                            <div class="hero-badges mb-3">
                                <span class="f-badge primary"><i class="fa-solid fa-brain me-2"></i>AI Powered</span>
                                <span class="f-badge subtle"><i class="fa-solid fa-cloud me-2"></i>Microsoft Native</span>
                            </div>
                            <div class="row g-4 align-items-center">
                                <div class="col-lg-7">
                                    <h2 class="hero-title">A premium, role-aware learning library designed like a modern Microsoft product</h2>
                                    <p class="hero-copy">
                                        Discover course resources, preview knowledge assets, explore module-based learning paths, and use AI-assisted search,
                                        metadata, and governance patterns in one clean enterprise workspace.
                                    </p>
                                    <div class="action-grid">
                                        @foreach (var action in QuickActions)
                                        {
                                            <a href="@action.Target" class="action-tile" aria-label="@action.Title">
                                                <span class="action-icon"><i class="@action.Icon" aria-hidden="true"></i></span>
                                                <span>@action.Title</span>
                                            </a>
                                        }
                                    </div>
                                    <div class="welcome-callout mt-4">
                                        <div class="callout-icon"><i class="fa-solid fa-circle-info" aria-hidden="true"></i></div>
                                        <div>
                                            <h3 class="h5 mb-2">Welcome to intelligent enterprise learning</h3>
                                            <p class="mb-0">Use the library to browse course structures, search knowledge, open governed learning assets, and continue progress across recent and favorite resources.</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-5">
                                    <div class="hero-illustration" aria-hidden="true">
                                        <div class="surface-shell">
                                            <div class="surface-top">
                                                <span></span><span></span><span></span>
                                            </div>
                                            <div class="surface-main">
                                                <div class="surface-left">
                                                    <div class="tiny-pill active"></div>
                                                    <div class="tiny-pill"></div>
                                                    <div class="tiny-pill"></div>
                                                    <div class="tiny-pill"></div>
                                                </div>
                                                <div class="surface-right">
                                                    <div class="bar-row"></div>
                                                    <div class="graph-card"></div>
                                                    <div class="tile-grid">
                                                        <div></div><div></div><div class="wide"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="float-pill blue"><i class="fa-solid fa-book-open-reader"></i> Library</div>
                                        <div class="float-pill gold"><i class="fa-solid fa-brain"></i> AI</div>
                                        <div class="float-pill green"><i class="fa-solid fa-chart-line"></i> Insights</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-xl-4">
                        <div class="right-rail h-100">
                            <h2 class="surface-title">Workspace snapshot</h2>
                            <div class="row g-3 mb-3">
                                @foreach (var metric in HeroMetrics)
                                {
                                    <div class="col-12 col-sm-6 col-xl-12">
                                        <RadzenCard class="rz-surface-card metric-card h-100">
                                            <div class="d-flex gap-3 align-items-start">
                                                <div class="metric-icon"><i class="@metric.Icon" aria-hidden="true"></i></div>
                                                <div>
                                                    <div class="metric-value">@metric.Value</div>
                                                    <h3 class="metric-title">@metric.Title</h3>
                                                    <p class="metric-copy mb-0">@metric.Description</p>
                                                </div>
                                            </div>
                                        </RadzenCard>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="overview" class="section-gap">
            <div class="container-xxl">
                <div class="section-heading">
                    <span class="eyebrow">Enterprise Overview</span>
                    <h2 class="section-title">What the LMS Library Viewer is built to do</h2>
                    <p class="section-copy">This experience is not a simple landing page. It is a structured enterprise dashboard for library discovery, knowledge access, document preview, AI assistance, and governed learning content operations.</p>
                </div>
                <div class="row g-4 align-items-stretch">
                    <div class="col-12 col-lg-8">
                        <RadzenCard class="rz-surface-card feature-hero h-100">
                            <div class="feature-panel-header">
                                <div>
                                    <h3 class="panel-title">LMS Library Viewer</h3>
                                    <p class="panel-copy mb-0">A course-aware, SharePoint-aligned, Microsoft Graph-ready content experience for students, trainers, and administrators.</p>
                                </div>
                                <span class="micro-tag">Knowledge Platform</span>
                            </div>
                            <div class="row g-3 mt-2">
                                <div class="col-md-6">
                                    <div class="mini-surface">
                                        <h4><i class="fa-solid fa-cloud me-2"></i>SharePoint document libraries</h4>
                                        <p class="mb-0">Use modern document libraries for structured storage, metadata, controlled sharing, and version history.</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mini-surface">
                                        <h4><i class="fa-solid fa-sitemap me-2"></i>Microsoft Graph context</h4>
                                        <p class="mb-0">Enable connected experiences, profile-aware content relevance, and Microsoft 365-aligned discovery workflows.</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mini-surface">
                                        <h4><i class="fa-solid fa-brain me-2"></i>AI knowledge acceleration</h4>
                                        <p class="mb-0">Support summaries, semantic search, recommendations, content notes, and metadata assistance in a governed way.</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mini-surface">
                                        <h4><i class="fa-solid fa-shield-halved me-2"></i>Role-based enterprise security</h4>
                                        <p class="mb-0">Separate administration, trainer ownership, learner read access, and guest restrictions safely and clearly.</p>
                                    </div>
                                </div>
                            </div>
                        </RadzenCard>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="d-grid gap-3 h-100">
                            @foreach (var item in RightRailInsights)
                            {
                                <RadzenCard class="rz-surface-card side-insight h-100">
                                    <div class="d-flex gap-3 align-items-start">
                                        <div class="info-icon"><i class="@item.Icon" aria-hidden="true"></i></div>
                                        <div>
                                            <h3 class="h6 mb-2">@item.Title</h3>
                                            <p class="mb-0 small-panel-copy">@item.Description</p>
                                        </div>
                                    </div>
                                </RadzenCard>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="section-gap section-muted">
            <div class="container-xxl">
                <div class="section-heading text-center">
                    <span class="eyebrow">Platform Capabilities</span>
                    <h2 class="section-title">Organized, premium, and enterprise-ready</h2>
                    <p class="section-copy mx-auto">Capability cards use Radzen card surfaces for clean grouping, while the overall visual pattern follows Microsoft Fluent 2 hierarchy, spacing, and focus principles. </p>
                </div>
                <div class="row g-4">
                    @foreach (var card in Capabilities)
                    {
                        <div class="col-12 col-sm-6 col-xl-3">
                            <RadzenCard class="rz-surface-card capability-card h-100">
                                <div class="cap-icon"><i class="@card.Icon" aria-hidden="true"></i></div>
                                <h3 class="cap-title">@card.Title</h3>
                                <p class="cap-copy mb-0">@card.Description</p>
                            </RadzenCard>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section id="journey" class="section-gap">
            <div class="container-xxl">
                <div class="section-heading">
                    <span class="eyebrow">How to Use</span>
                    <h2 class="section-title">Microsoft-style guided learning journey</h2>
                    <p class="section-copy">The timeline below uses generous whitespace and a clean vertical rhythm so the page feels intentional instead of crowded, which is central to Fluent 2 layout guidance. </p>
                </div>
                <div class="journey-panel">
                    <div class="timeline-track"></div>
                    @foreach (var step in Journey)
                    {
                        <article class="timeline-item">
                            <div class="timeline-dot">@step.Number</div>
                            <div class="timeline-card">
                                <h3 class="h5 mb-2">@step.Title</h3>
                                <p class="mb-0">@step.Description</p>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </section>

        <section id="guide" class="section-gap section-muted">
            <div class="container-xxl">
                <div class="section-heading">
                    <span class="eyebrow">Content Library User Guide</span>
                    <h2 class="section-title">Detailed instructions for browsing, searching, opening, and studying content</h2>
                    <p class="section-copy">The library experience should teach users how to navigate content, understand metadata, use preview-first workflows, and complete the learning journey confidently.</p>
                </div>
                <div class="row g-4">
                    @foreach (var block in GuideBlocks)
                    {
                        <div class="col-12 col-xl-6">
                            <RadzenCard class="rz-surface-card guide-card h-100">
                                <div class="d-flex gap-3 align-items-center mb-3">
                                    <div class="cap-icon compact"><i class="@block.Icon" aria-hidden="true"></i></div>
                                    <h3 class="h4 mb-0">@block.Title</h3>
                                </div>
                                <ul class="guide-list mb-0">
                                    @foreach (var item in block.Items)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            </RadzenCard>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section class="section-gap">
            <div class="container-xxl">
                <div class="section-heading">
                    <span class="eyebrow">CRUD Guide</span>
                    <h2 class="section-title">Governed content operations for enterprise learning management</h2>
                    <p class="section-copy">These instruction panels describe how to create, read, update, and delete content safely while preserving structure, search quality, and compliance.</p>
                </div>
                <div class="row g-4">
                    @foreach (var panel in CrudPanels)
                    {
                        <div class="col-12 col-xl-6">
                            <RadzenCard class="rz-surface-card crud-card h-100">
                                <div class="d-flex gap-3 align-items-center mb-3">
                                    <div class="cap-icon compact"><i class="@panel.Icon" aria-hidden="true"></i></div>
