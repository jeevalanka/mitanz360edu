@page "/course-builder"

@using System.Text.Json
@using System.Text.Json.Nodes

@inject IWebHostEnvironment Env

<RadzenRow Style="height:100vh">

    <!-- LEFT PANEL -->
    <RadzenColumn Size="4">
        <RadzenCard Style="height:100%;overflow:auto">

            <h3>Course Builder</h3>

            @if (JsonModel != null && JsonModel.Count > 0)
            {
                <ErrorBoundary>
                    @RenderJson(JsonModel)
                </ErrorBoundary>
            }
            else
            {
                <RadzenCard Style="margin:10px;padding:10px">
                    <h4>No Data Loaded</h4>
                    <p>Check template.json file</p>
                </RadzenCard>
            }

            <RadzenStack Gap="10px" Style="margin-top:20px">
                <RadzenButton Text="New" Click="@LoadTemplate" Style="width:100%" />
                <RadzenButton Text="Save JSON" Click="@SaveJson" Style="width:100%" />
                <RadzenButton Text="Generate DOCX" Click="@GenerateDocx" Style="width:100%" />
            </RadzenStack>

        </RadzenCard>
    </RadzenColumn>

    <!-- JSON PANEL -->
    <RadzenColumn Size="4">
        <RadzenCard Style="height:100%">
            <h3>JSON Editor</h3>

            <RadzenTextArea @bind-Value="JsonText"
                            Style="width:100%;height:90%" />

            <RadzenButton Text="Apply JSON"
                          Style="width:100%"
                          Click="@ApplyJson" />
        </RadzenCard>
    </RadzenColumn>

    <!-- PREVIEW -->
    <RadzenColumn Size="4">
        <RadzenCard>
            <h3>Preview</h3>
            <pre>@JsonText</pre>
        </RadzenCard>
    </RadzenColumn>

</RadzenRow>

@code {

    private JsonObject JsonModel = new();
    private string JsonText = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplate();
    }

    // ✅ LOAD TEMPLATE
    private async Task LoadTemplate()
    {
        try
        {
            var path = Path.Combine(Env.WebRootPath, "Data", "New-Course", "template.json");

            if (!File.Exists(path))
            {
                JsonModel = new JsonObject
                {
                    ["Error"] = "template.json NOT FOUND"
                };

                SyncText();
                return;
            }

            var json = await File.ReadAllTextAsync(path);
            JsonModel = JsonNode.Parse(json)?.AsObject() ?? new JsonObject();

            SyncText();
        }
        catch (Exception ex)
        {
            JsonModel = new JsonObject
            {
                ["Error"] = ex.Message
            };
            SyncText();
        }
    }

    // ✅ SYNC JSON TEXT
    private void SyncText()
    {
        JsonText = JsonModel.ToJsonString(new JsonSerializerOptions
        {
            WriteIndented = true
        });
    }

    // ✅ APPLY JSON
    private void ApplyJson()
    {
        try
        {
            JsonModel = JsonNode.Parse(JsonText)?.AsObject() ?? new JsonObject();
        }
        catch
        {
            // invalid JSON - ignore
        }
    }

    // ✅ SAVE JSON (Version-ready base)
    private async Task SaveJson()
    {
        var folder = Path.Combine(Env.WebRootPath, "Data", "New-Course");

        if (!Directory.Exists(folder))
            Directory.CreateDirectory(folder);

        var courseName = JsonModel["CourseInformation"]?["CourseName"]?.ToString() ?? "Course";

        var file = Path.Combine(folder, $"{courseName}-v1.0.json");

        await File.WriteAllTextAsync(file, JsonText);
    }

    // ✅ DOCX GENERATION (basic)
    private async Task GenerateDocx()
    {
        var folder = Path.Combine(Env.WebRootPath, "Data", "New-Course");

        if (!Directory.Exists(folder))
            Directory.CreateDirectory(folder);

        var courseName = JsonModel["CourseInformation"]?["CourseName"]?.ToString() ?? "Course";

        var path = Path.Combine(folder, $"{courseName}-v1.0.docx");

        using var doc = DocumentFormat.OpenXml.Packaging.WordprocessingDocument
            .Create(path, DocumentFormat.OpenXml.WordprocessingDocumentType.Document);

        var main = doc.AddMainDocumentPart();
        main.Document = new DocumentFormat.OpenXml.Wordprocessing.Document(
            new DocumentFormat.OpenXml.Wordprocessing.Body()
        );

        var body = main.Document.Body;

        body.Append(new DocumentFormat.OpenXml.Wordprocessing.Paragraph(
            new DocumentFormat.OpenXml.Wordprocessing.Run(
                new DocumentFormat.OpenXml.Wordprocessing.Text(courseName)
            )
        ));

        await Task.CompletedTask;
    }

    // ✅ DYNAMIC JSON FORM RENDERER (SAFE VERSION)
    private RenderFragment RenderJson(JsonNode? node) => builder =>
    {
        if (node == null) return;

        int seq = 0;

        if (node is JsonObject obj)
        {
            foreach (var kv in obj)
            {
                var key = kv.Key;
                var val = kv.Value;

                // Label
                builder.OpenComponent<RadzenLabel>(seq++);
                builder.AddAttribute(seq++, "Text", key);
                builder.CloseComponent();

                // ✅ DROPDOWN
                if (val is JsonObject sub &&
                    sub["Options"] is JsonArray options)
                {
                    var list = options.Select(x => x?.ToString() ?? "").ToList();
                    var selectedValue = sub["Value"]?.ToString() ?? "";

                    builder.OpenComponent<RadzenDropDown<string>>(seq++);
                    builder.AddAttribute(seq++, "Data", list);
                    builder.AddAttribute(seq++, "Value", selectedValue);

                    builder.AddAttribute(seq++, "Change",
                        EventCallback.Factory.Create<object>(this, v =>
                        {
                            sub["Value"] = v?.ToString();
                            SyncText();
                        }));

                    builder.AddAttribute(seq++, "Style", "width:100%");
                    builder.CloseComponent();
                }
                // ✅ TEXT FIELD
                else if (val is JsonValue)
                {
                    var stringVal = val?.ToString() ?? "";

                    builder.OpenComponent<RadzenTextBox>(seq++);
                    builder.AddAttribute(seq++, "Value", stringVal);

                    builder.AddAttribute(seq++, "Change",
                        EventCallback.Factory.Create<object>(this, v =>
                        {
                            obj[key] = v?.ToString();
                            SyncText();
                        }));

                    builder.AddAttribute(seq++, "Style", "width:100%");
                    builder.CloseComponent();
                }
                // ✅ NESTED OBJECT
                else
                {
                    builder.OpenComponent<RadzenCard>(seq++);
                    builder.AddAttribute(seq++, "Style", "margin:10px;padding:10px;background:#f8f9fa");

                    builder.AddAttribute(seq++, "ChildContent",
                        (RenderFragment)(child =>
                        {
                            child.AddContent(0, RenderJson(val));
                        }));

                    builder.CloseComponent();
                }
            }
        }
    };
}