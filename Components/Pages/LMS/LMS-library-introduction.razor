    private readonly IReadOnlyList<GuideBlock> GuideBlocks =
    [
        new("Browse Content", "fa-solid fa-folder-open",
            [
                "Use the folder tree to navigate from academy to program, course, module, and lesson in a logical sequence.",
                "Follow breadcrumbs to understand where you are in the library and return to broader course areas quickly.",
                "Recognize file icons, learning type badges, and metadata chips to identify the right asset faster.",
                "Use categorized landing cards for all resources, favorites, recent files, and role-relevant recommendations."
            ]),
        new("Search Experience", "fa-solid fa-magnifying-glass",
            [
                "Use keyword search for titles, document names, module names, and indexed content within files where available.",
                "Use metadata search when you know the course, owner, topic, delivery type, category, approval state, or tag.",
                "Use AI-assisted semantic search to retrieve conceptually related results even when exact wording differs.",
                "Filter by file type to find only Word, Excel, PowerPoint, PDF, image, video, Markdown, code, or archive files."
            ]),
        new("Open, Preview, and Download", "fa-solid fa-file-lines",
            [
                "Use preview mode to inspect Office files, PDFs, images, media, and other supported learning resources before opening.",
                "Review metadata such as owner, audience, category, version, tags, module, and approval state before reuse.",
                "Check version history when a document has changed or when a newer release may have replaced previous guidance.",
                "Download files only where access policy, learning workflow, and document classification permit local copies."
            ]),
        new("Learning Workflow", "fa-solid fa-graduation-cap",
            [
                "Read the core document set first to understand concepts, language, outcomes, and required knowledge.",
                "Watch demonstrations and complete labs to reinforce theory with practical application.",
