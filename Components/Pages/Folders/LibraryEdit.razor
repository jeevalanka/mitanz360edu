@page "/library-edit/{ItemId}"
@layout MainLayout_No_Left_RightPan

@using MITANZ360Edu.Web.Services
@using MITANZ360Edu.Web.Models
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json

@inject SharePointService _spService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState

<PageTitle>LMS Content Editor — MITANZ360Edu</PageTitle>


<!-- ═══════════════════════════════════════════════════════════
     TOP BAR
═══════════════════════════════════════════════════════════ -->
<div class="lms-editor">

    <div class="lms-topbar">
        <a href="/lms-library" class="back-btn">← Back</a>
        <h1>LMS Content Editor</h1>
        @if (Item != null)
        {
            <div class="topbar-file" title="@Item.Name">📄 @Item.Name</div>
            <span class="topbar-status @GetPublishStatusClass()">
                @GetPublishStatusLabel()
            </span>
        }
        <div class="topbar-spacer"></div>
        @if (Item != null)
        {
            <span style="font-size:.75rem;color:rgba(255,255,255,.7);">
                Modified @Item.LastModified?.ToString("dd MMM yyyy HH:mm")
            </span>
        }
    </div>

    <!-- ── BREADCRUMB ── -->
    <div class="lms-breadcrumb">
        <a href="/lms-library">📚 LMS Library</a>
        <span class="crumb-sep">›</span>
        @if (Item != null && !string.IsNullOrEmpty(Item.CourseId))
        {
            <a href="/lms-library">@Item.CourseId</a>
            <span class="crumb-sep">›</span>
        }
        <span>@(Item?.Name ?? "Loading…")</span>
    </div>
    
    <!-- ═══════════════════════════════════════════════════════════
         BODY
    ═══════════════════════════════════════════════════════════ -->
    <div class="lms-body">

        <!-- ── MAIN EDIT PANEL ── -->
        <div class="lms-main">

            @if (isLoading)
            {
                <div class="loading-state">
                    <span class="spin-blue"></span>
                    Loading content item…
                </div>
                <!-- Skeleton cards -->
                <div class="f-card">
                    <div class="f-card-body">
                        <div class="skeleton" style="height:20px;width:40%;margin-bottom:16px;"></div>
                        <div class="skeleton" style="height:38px;margin-bottom:12px;"></div>
                        <div class="skeleton" style="height:38px;margin-bottom:12px;"></div>
                        <div class="skeleton" style="height:80px;"></div>
                    </div>
                </div>
            }
            else if (Item == null)
            {
                <div class="f-alert error">
                    ⛔ Content item not found. It may have been moved or deleted.
                    <a href="/lms-library" class="btn-ghost" style="margin-left:auto;">← Back to Library</a>
                </div>
            }
            else
            {
                <!-- STATUS MESSAGE -->
                @if (!string.IsNullOrEmpty(StatusMessage))
                {
                    <div class="f-alert @StatusClass">
                        <span>@StatusIcon</span>
                        <span style="flex:1;">@StatusMessage</span>
                        <button type="button" class="btn-ghost" style="padding:0 6px;"
                                @onclick="() => StatusMessage = string.Empty">
                            ✕
                        </button>
                    </div>
                }

                <!-- ═══════════════════════════════════════
                     CARD 1 — GENERAL INFORMATION
                     Fields: Title, ContentId, CourseId, Description
                ═══════════════════════════════════════ -->
                <div class="f-card">
                    <div class="f-card-header">
                        <div class="f-card-icon">📋</div>
                        <h3>General Information</h3>
                        <span class="f-card-badge">Core</span>
                    </div>
                    <div class="f-card-body">

                        <div class="f-grid-2">
                            <!-- COR_ContentId -->
                            <div class="f-field">
                                <label class="f-label">Content ID</label>
                                <input class="f-input" @bind="Item.ContentId"
                                       placeholder="e.g. COR-001" readonly/>
                            </div>
                            <!-- COR_CourseId -->
                            <div class="f-field">
                                <label class="f-label">Course ID</label>
                                <RadzenDropDown Data="@courseDropdownList"
                                                TextProperty="Display"
                                                ValueProperty="Code"
                                                @bind-Value="Item.CourseId"
                                                Change="OnCourseChanged"
                                                Style="width:100%" />

                            </div>
                        </div>

                        <!-- Title -->
                        <div class="f-field">
                            <label class="f-label">Title <span class="req">*</span></label>
                            <input class="f-input" @bind="Item.Title"
                                   placeholder="Enter a descriptive title for this content" />
                            <span class="f-hint">SP: Title — displayed in course explorer and search results.</span>
                        </div>

                        <!-- _ExtendedDescription -->
                        <div class="f-field">
                            <label class="f-label">Description</label>
                            <textarea class="f-textarea" @bind="Item.Description"
                                      rows="3"
                                      placeholder="Describe what learners will find in this content…"></textarea>
                        </div>

                        <!-- COR_CourseModel -->
                        <div class="f-field" style="max-width:340px;">
                            <label class="f-label">Course Model Code</label>
                            <input class="f-input" @bind="Item.CourseModelCode"
                                   placeholder="e.g. MOD-01" />
                        </div>

                    </div>
                </div>

                <!-- ═══════════════════════════════════════
                     CARD 2 — METADATA / GOVERNANCE
                     Fields: ContentTypeCode, Source, IsPublished, IsArchived
                ═══════════════════════════════════════ -->
                <div class="f-card">
                    <div class="f-card-header">
                        <div class="f-card-icon">🏷️</div>
                        <h3>Metadata &amp; Governance</h3>
                        <span class="f-card-badge">Governance</span>
                    </div>
                    <div class="f-card-body">

                        <!-- Tabs: Governance | Extended | AI -->
                        <div class="meta-tabs">
                            <button type="button"
                                    class="meta-tab @(MetaTab == 0 ? "active" : "")"
                                    @onclick="() => MetaTab = 0">
                                ⚙️ Governance
                            </button>
                            <button type="button"
                                    class="meta-tab @(MetaTab == 1 ? "active" : "")"
                                    @onclick="() => MetaTab = 1">
                                📦 Extended
                            </button>
                            <button type="button"
                                    class="meta-tab @(MetaTab == 2 ? "active" : "")"
                                    @onclick="() => MetaTab = 2">
                                🤖 AI Feed
                            </button>
                            <button type="button"
                                    class="meta-tab @(MetaTab == 3 ? "active" : "")"
                                    @onclick="() => MetaTab = 3">
                                🎯 ACT
                            </button>
                        </div>

                        @if (MetaTab == 0)
                        {
                            <!-- GOVERNANCE TAB -->
                            <div class="f-grid-2">
                                <!-- COR_ContentType -->
                                <div class="f-field">
                                    <label class="f-label">Content Type</label>
                                    <select class="f-select" @bind="Item.ContentTypeCode">
                                        <option value="">— Select —</option>
                                        <option value="reading">📖 Reading</option>
                                        <option value="video">🎬 Video</option>
                                        <option value="quiz">✅ Quiz</option>
                                        <option value="assignment">📝 Assignment</option>
                                        <option value="lab">🧪 Lab</option>
                                        <option value="group">👥 Group Activity</option>
                                        <option value="resource">📎 Resource</option>
                                        <option value="image">🖼️ Image</option>
                                        <option value="audio">🔊 Audio</option>
                                        <option value="other">📄 Other</option>
                                    </select>
                                </div>
                                <!-- GOV_Source -->
                                <div class="f-field">
                                    <label class="f-label">Content Source</label>
                                    <select class="f-select" @bind="Item.Source">
                                        <option value="">— Select —</option>
                                        <option value="internal">Internal</option>
                                        <option value="microsoft-learn">Microsoft Learn</option>
                                        <option value="external">External URL</option>
                                        <option value="upload">Uploaded File</option>
                                        <option value="ai-generated">AI Generated</option>
                                    </select>
                                </div>
                            </div>

                            <!-- REL_IsPublished / ARC_IsArchived -->
                            <div style="margin-top:8px;">
                                <div class="toggle-row">
                                    <div class="toggle-label">
                                        <strong>Published</strong>
                                        <span>SP: Published — only published items are visible to learners.</span>
                                    </div>
                                    <label class="f-toggle">
                                        <input type="checkbox" @bind="Item.IsPublished" />
                                        <span class="track"></span>
                                    </label>
                                </div>
                                <div class="toggle-row">
                                    <div class="toggle-label">
                                        <strong>Archived</strong>
                                        <span>SP: Archived — archived items are hidden from learners.</span>
                                    </div>
                                    <label class="f-toggle">
                                        <input type="checkbox" @bind="Item.IsArchived" />
                                        <span class="track"></span>
                                    </label>
                                </div>
                            </div>
                        }
                        else if (MetaTab == 1)
                        {
                            <!-- EXTENDED METADATA JSON -->
                            <div class="f-field">
                                <label class="f-label">Extended Metadata JSON</label>
                                <textarea class="json-editor" @bind="Item.MetadataJson"
                                          rows="8"
                                          placeholder='{ "key": "value" }'></textarea>
                                <span class="f-hint">SP: Ext. Metadata — Free form JSON for custom attributes.</span>
                            </div>
                            <div style="display:flex;gap:8px;margin-top:6px;">
                                <button type="button" class="btn-ghost" @onclick="FormatMetadataJson">
                                    ✨ Format JSON
                                </button>
                                <button type="button" class="btn-ghost" @onclick="ValidateMetadataJson">
                                    ✔ Validate
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(JsonValidationMsg))
                            {
                                <div class="f-alert @JsonValidationClass" style="margin-top:10px;">
                                    @JsonValidationMsg
                                </div>
                            }
                        }
                        else if (MetaTab == 2)
                        {
                            <!-- AI FEED -->
                            <div class="f-alert info" style="margin-bottom:12px;">
                                🤖 AI Feed is used by the MITANZ AI Engine to generate summaries,
                                quizzes, and learning recommendations for this content.
                            </div>
                            <div class="f-field">
                                <label class="f-label">AI Feed Content</label>
                                <textarea class="f-textarea" @bind="Item.AiFeed"
                                          rows="6"
                                          placeholder="Paste the AI-readable content excerpt or prompt feed here…"></textarea>
                                <span class="f-hint">SP: AI Feed — Plain text or structured content for AI processing.</span>
                            </div>
                        }
                        else if (MetaTab == 3)
                        {
                            <!-- ACT METADATA -->
                            <div class="f-alert info" style="margin-bottom:12px;">
                                🎯 Activity metadata controls how this item behaves in the LMS
                                activity sequence (reading, video, quiz, lab, etc).
                            </div>

                            <!-- ACT Type Pills -->
                            <div class="f-field">
                                <label class="f-label">Activity Type</label>
                                <div class="act-pills-row">
                                    @foreach (var t in new[] { "reading", "video", "quiz", "group", "lab", "assignment" })
                                    {
                                        <button type="button"
                                                class="act-pill @(ActMeta.Type == t ? "selected" : "")"
                                                @onclick="() => ActMeta.Type = t">
                                            @GetActTypeIcon(t) @t
                                        </button>
                                    }
                                </div>
                            </div>

                            <div class="f-grid-2">
                                <div class="f-field">
                                    <label class="f-label">Activity Title</label>
                                    <input class="f-input" @bind="ActMeta.Title"
                                           placeholder="Short activity title" />
                                </div>
                                <div class="f-field">
                                    <label class="f-label">External URL</label>
                                    <input class="f-input" @bind="ActMeta.Url"
                                           placeholder="https://…" type="url" />
                                    <span class="f-hint">For MS-Learn / Quiz / Lab links.</span>
                                </div>
                            </div>

                            <div class="f-grid-3">
                                <div class="f-field">
                                    <label class="f-label">Duration (min)</label>
                                    <input class="f-input" @bind="ActMeta.DurationMinutes"
                                           type="number" min="0" placeholder="0" />
                                </div>
                                <div class="f-field">
                                    <label class="f-label">Passing Score (%)</label>
                                    <input class="f-input" @bind="ActMeta.PassingScore"
                                           type="number" min="0" max="100" placeholder="0" />
                                </div>
                                <div class="f-field" style="display:flex;align-items:center;gap:10px;padding-top:22px;">
                                    <label class="f-toggle">
                                        <input type="checkbox" @bind="ActMeta.IsMandatory" />
                                        <span class="track"></span>
                                    </label>
                                    <div class="toggle-label">
                                        <strong>Mandatory</strong>
                                        <span>Required for completion</span>
                                    </div>
                                </div>
                            </div>

                            <div class="f-field">
                                <label class="f-label">Activity Description</label>
                                <textarea class="f-textarea" @bind="ActMeta.Description"
                                          rows="3"
                                          placeholder="What does the learner do in this activity?"></textarea>
                            </div>

                            <div style="display:flex;gap:8px;margin-top:6px;">
                                <button type="button" class="btn-ghost" @onclick="SyncActMetaToJson">
                                    💾 Sync ACT to JSON
                                </button>
                            </div>
                        }

                    </div>
                </div>

                <!-- ═══════════════════════════════════════
                     CARD 3 — FILE INFORMATION (READ ONLY)
                ═══════════════════════════════════════ -->
                <div class="f-card">
                    <div class="f-card-header">
                        <div class="f-card-icon">📁</div>
                        <h3>File Information</h3>
                        <span class="f-card-badge">Read Only</span>
                    </div>
                    <div class="f-card-body">
                        <div class="f-grid-2">
                            <div class="f-field">
                                <label class="f-label">File Name</label>
                                <input class="f-input" value="@Item.Name" readonly />
                            </div>
                            <div class="f-field">
                                <label class="f-label">File Size</label>
                                <input class="f-input" value="@FormatFileSize(Item.Size)" readonly />
                            </div>
                            <div class="f-field">
                                <label class="f-label">MIME Type</label>
                                <input class="f-input" value="@(Item.ContentType ?? "Folder")" readonly />
                            </div>
                            <div class="f-field">
                                <label class="f-label">Last Modified</label>
                                <input class="f-input" value="@Item.LastModified?.ToString("dd MMM yyyy  HH:mm")" readonly />
                            </div>
                            <div class="f-field">
                                <label class="f-label">Drive ID</label>
                                <input class="f-input" value="@Item.DriveId" readonly
                                       style="font-family:monospace;font-size:.75rem;" />
                            </div>
                            <div class="f-field">
                                <label class="f-label">Item ID</label>
                                <input class="f-input" value="@Item.Id" readonly
                                       style="font-family:monospace;font-size:.75rem;" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ── STICKY ACTION BAR ── -->
                <div class="lms-action-bar">
                    <button type="button"
                            class="btn-primary"
                            @onclick="SaveChangesAsync"
                            disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spin"></span> <span>Saving…</span>
                        }
                        else
                        {

                            <span>💾</span> <span>Save Changes</span>
                        }
                    </button>

                    <button type="button"
                            class="btn-open-online"
                            @onclick="OpenOnlineAsync"
                            disabled="@string.IsNullOrEmpty(Item.WebUrl)">
                        🔗 Open Online
                    </button>

                    <button type="button"
                            class="btn-danger"
                            @onclick="() => showDeleteConfirm = true"
                            disabled="@(isSaving || isDeleting)">
                        🗑 Delete
                    </button>

                    <button type="button"
                            class="btn-secondary"
                            @onclick="CancelEdit"
                            disabled="@isSaving">
                        ✕ Cancel
                    </button>

                    <button @onclick="ViewDocument" class="btn-secondary">
                        View / Download
                    </button>


                    @if (LastSavedAt.HasValue)
                    {
                        <span style="font-size:.75rem;color:#94a3b8;margin-left:8px;">
                            ✔ Saved @LastSavedAt.Value.ToString("HH:mm:ss")
                        </span>
                    }
                </div>
            }
        </div>

        <!-- ═══════════════════════════════════════════════════════════
             RIGHT PANEL — QUICK INFO + STATUS + RELATED
        ═══════════════════════════════════════════════════════════ -->
        <div class="lms-right">

            @if (Item != null)
            {
                <!-- PUBLISH STATUS BANNER -->
                <div class="publish-banner @GetPublishBannerClass()">
                    <span style="font-size:1.2rem;">@GetPublishBannerIcon()</span>
                    <div>
                        <div style="font-weight:700;font-size:.88rem;">@GetPublishStatusLabel()</div>
                        <div style="font-size:.72rem;opacity:.85;">@GetPublishBannerSub()</div>
                    </div>
                </div>

                <!-- QUICK INFO -->
                <div class="mini-card">
                    <h4>Quick Info</h4>
                    <div class="quick-info-row">
                        <span class="qi-label">File</span>
                        <span class="qi-value">@Item.Name</span>
                    </div>
                    <div class="quick-info-row">
                        <span class="qi-label">Type</span>
                        <span class="qi-value">
                            <span class="file-type-badge @GetFileTypeCss()">
                                @GetFileTypeIcon() @GetFileTypeLabel()
                            </span>
                        </span>
                    </div>
                    <div class="quick-info-row">
                        <span class="qi-label">Size</span>
                        <span class="qi-value">@FormatFileSize(Item.Size)</span>
                    </div>
                    <div class="quick-info-row">
                        <span class="qi-label">Modified</span>
                        <span class="qi-value">@Item.LastModified?.ToString("dd MMM yyyy")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Item.CourseId))
                    {
                        <div class="quick-info-row">
                            <span class="qi-label">Course</span>
                            <span class="qi-value">@Item.CourseId</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Item.ContentId))
                    {
                        <div class="quick-info-row">
                            <span class="qi-label">Content ID</span>
                            <span class="qi-value" style="font-family:monospace;font-size:.75rem;">@Item.ContentId</span>
                        </div>
                    }
                </div>

                <!-- CONTENT TYPE -->
                @if (!string.IsNullOrEmpty(Item.ContentTypeCode))
                {
                    <div class="mini-card">
                        <h4>Content Type</h4>
                        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                            <span class="ct-tag">@GetActTypeIcon(Item.ContentTypeCode) @Item.ContentTypeCode</span>
                            @if (!string.IsNullOrEmpty(Item.Source))
                            {
                                <span class="ct-tag" style="background:#f0fdf4;color:#10b981;border-color:#bbf7d0;">
                                    🌐 @Item.Source
                                </span>
                            }
                        </div>
                    </div>
                }

                <!-- GOVERNANCE FLAGS -->
                <div class="mini-card">
                    <h4>Governance</h4>
                    <div class="toggle-row">
                        <div class="toggle-label">
                            <strong>Published</strong>
                            <span>Visible to learners</span>
                        </div>
                        <label class="f-toggle">
                            <input type="checkbox" @bind="Item.IsPublished" />
                            <span class="track"></span>
                        </label>
                    </div>
                    <div class="toggle-row">
                        <div class="toggle-label">
                            <strong>Archived</strong>
                            <span>Hidden from learners</span>
                        </div>
                        <label class="f-toggle">
                            <input type="checkbox" @bind="Item.IsArchived" />
                            <span class="track"></span>
                        </label>
                    </div>
                </div>

                <!-- ACT METADATA QUICK VIEW -->
                @if (ActMeta != null && !string.IsNullOrEmpty(ActMeta.Type))
                {
                    <div class="mini-card">
                        <h4>Activity</h4>
                        <div class="quick-info-row">
                            <span class="qi-label">Type</span>
                            <span class="qi-value">@GetActTypeIcon(ActMeta.Type) @ActMeta.Type</span>
                        </div>
                        @if (ActMeta.DurationMinutes > 0)
                        {
                            <div class="quick-info-row">
                                <span class="qi-label">Duration</span>
                                <span class="qi-value">@ActMeta.DurationMinutes min</span>
                            </div>
                        }
                        <div class="quick-info-row">
                            <span class="qi-label">Mandatory</span>
                            <span class="qi-value">@(ActMeta.IsMandatory ? "✅ Yes" : "No")</span>
                        </div>
                    </div>
                }

                <!-- QUICK ACTIONS -->
                <div class="mini-card">
                    <h4>Quick Actions</h4>
                    <div style="display:flex;flex-direction:column;gap:6px;">
                        <button type="button" class="btn-secondary"
                                style="width:100%;justify-content:flex-start;"
                                @onclick="TogglePublishAsync"
                                disabled="@isSaving">
                            @(Item.IsPublished ? "⬇️ Unpublish" : "✅ Publish Now")
                        </button>
                        <button type="button" class="btn-secondary"
                                style="width:100%;justify-content:flex-start;"
                                @onclick="ToggleArchiveAsync"
                                disabled="@isSaving">
                            @(Item.IsArchived ? "📤 Unarchive" : "🗄 Archive")
                        </button>
                        <button type="button" class="btn-ghost"
                                style="width:100%;justify-content:flex-start;"
                                @onclick="CopyItemIdToClipboard">
                            📋 Copy Item ID
                        </button>
                    </div>
                </div>
            }
            else if (isLoading)
            {
                <div class="skeleton" style="height:80px;border-radius:10px;"></div>
                <div class="skeleton" style="height:140px;border-radius:10px;"></div>
                <div class="skeleton" style="height:100px;border-radius:10px;"></div>
            }

        </div>

    </div><!-- end lms-body -->

</div>
<!-- end lms-editor -->

<!-- ═══════════════════════════════════════════════════════════
     DELETE CONFIRMATION DIALOG
═══════════════════════════════════════════════════════════ -->
@if (showDeleteConfirm)
{
    <div class="confirm-overlay" @onclick="() => showDeleteConfirm = false">
        <div class="confirm-box" @onclick:stopPropagation="true">
            <h4>🗑 Delete this item?</h4>
            <p>
                <strong>@Item?.Name</strong> will be permanently deleted from SharePoint.
                This action cannot be undone.
            </p>
            <div class="confirm-actions">
                <button type="button" class="btn-secondary"
                        @onclick="() => showDeleteConfirm = false">
                    Cancel
                </button>
                <button type="button" class="btn-danger"
                        @onclick="DeleteItemAsync"
                        disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <span class="spin" style="border-top-color:#ef4444;border-color:rgba(239,68,68,.3);"></span>
                        <span>Deleting…</span>
                    }
                    else
                    {

                        <span>🗑 Delete Permanently</span>
                    }
                </button>

            </div>
        </div>
    </div>
}


@code {

    [Parameter] public string ItemId { get; set; } = "";

    // ✅ Inject Configuration directly (clean solution)
    [Inject] IConfiguration Config { get; set; } = default!;

    private string DriveId = "";

    private LibraryItem? Item;
    private ActMetadata ActMeta = new();

    private bool isLoading = true;
    private bool isSaving = false;
    private bool isDeleting = false;
    private bool showDeleteConfirm = false;

    private string StatusMessage = "";
    private string StatusClass = "info";
    private string StatusIcon = "ℹ️";

    private DateTime? LastSavedAt;

    private int MetaTab = 0;

    private string JsonValidationMsg = "";
    private string JsonValidationClass = "info";

    List<CourseModel> courses = new();
    List<CourseDropdownDto> courseDropdownList = new();

    // ✅ INIT
    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            if (string.IsNullOrWhiteSpace(ItemId))
            {
                SetStatus("❌ Invalid item URL.", "error");
                return;
            }

            DriveId = Config["SharePoint:Libraries:LMS:DriveId"];

            if (string.IsNullOrWhiteSpace(DriveId))
            {
                SetStatus("❌ DriveId missing in config.", "error");
                return;
            }

            // ✅ Load item
            Item = await _spService.GetItemAsync(DriveId, ItemId);

            if (Item == null)
            {
                SetStatus("❌ Item not found.", "error");
                return;
            }

            // ✅ EXISTING LOGIC
            ParseActMeta();

            // ✅ ✅ ✅ ADD THIS BLOCK (Course Dropdown)

            var allCourses = (await _spService.GetCoursesAsync()).ToList();
            courses = allCourses;

            courseDropdownList = courses.Select(c => new CourseDropdownDto
            {
                Id = c.Id,
                Code = string.IsNullOrWhiteSpace(c.CourseCode)
                    ? $"COURSE-{c.Id}"
                    : c.CourseCode,
                Display = $"{c.CourseCode ?? "NO-CODE"} - {c.Title}"
            }).ToList();
        }
        catch (Exception ex)
        {
            SetStatus($"❌ Load error: {ex.Message}", "error");
        }
        finally
        {
            isLoading = false;
        }
    }
    // ✅ SAVE
    private async Task SaveChangesAsync()
    {
        if (Item == null) return;

        try
        {
            isSaving = true;
            StatusMessage = "";

            SyncActMetaToJson();

            // ✅ ✅ ADD HERE (THIS IS THE FIX)
            if (string.IsNullOrWhiteSpace(Item.ContentId))
            {
                Item.ContentId = GenerateCONTref();
            }

            // ✅ Save AFTER assigning ID
            await _spService.UpdateLibraryItemFullAsync(DriveId, ItemId, Item);

            LastSavedAt = DateTime.Now;
            SetStatus("✅ Saved successfully.", "success");
        }
        catch (Exception ex)
        {
            SetStatus($"❌ Save failed: {ex.Message}", "error");
        }
        finally
        {
            isSaving = false;
        }
    }
    // ✅ DELETE
    private async Task DeleteItemAsync()
    {
        if (Item == null) return;

        try
        {
            isDeleting = true;
            showDeleteConfirm = false;

            await _spService.DeleteItemAsync(DriveId, ItemId);

            Nav.NavigateTo("/lms-library?deleted=1");
        }
        catch (Exception ex)
        {
            SetStatus($"❌ Delete failed: {ex.Message}", "error");
        }
        finally
        {
            isDeleting = false;
        }
    }

    // ✅ QUICK ACTIONS
    private async Task TogglePublishAsync()
    {
        if (Item == null) return;
        Item.IsPublished = !Item.IsPublished;
        await SaveChangesAsync();
    }

    private async Task ToggleArchiveAsync()
    {
        if (Item == null) return;
        Item.IsArchived = !Item.IsArchived;
        await SaveChangesAsync();
    }

    private void CancelEdit() => Nav.NavigateTo("/lms-library");

    private async Task OpenOnlineAsync()
    {
        if (Item == null || string.IsNullOrEmpty(Item.WebUrl)) return;
        await JS.InvokeVoidAsync("open", Item.WebUrl, "_blank");
    }

    private async Task CopyItemIdToClipboard()
    {
        if (Item == null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", Item.Id);
        SetStatus("✅ Copied.", "success");
    }

    // ✅ ACT META
    private void ParseActMeta()
    {
        if (Item == null || string.IsNullOrWhiteSpace(Item.ACTMetaJson))
        {
            ActMeta = new();
            return;
        }

        try
        {
            ActMeta = JsonSerializer.Deserialize<ActMetadata>(
                Item.ACTMetaJson,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true }
            ) ?? new();
        }
        catch { ActMeta = new(); }
    }

    private void SyncActMetaToJson()
    {
        if (Item == null) return;

        try
        {
            Item.ACTMetaJson = JsonSerializer.Serialize(ActMeta);
        }
        catch { }
    }

    // ✅ JSON
    private void FormatMetadataJson()
    {
        if (Item == null) return;

        try
        {
            var parsed = JsonDocument.Parse(Item.MetadataJson ?? "{}");
            Item.MetadataJson = JsonSerializer.Serialize(parsed, new JsonSerializerOptions { WriteIndented = true });

            JsonValidationMsg = "✅ JSON formatted.";
            JsonValidationClass = "success";
        }
        catch (Exception ex)
        {
            JsonValidationMsg = $"❌ Invalid JSON: {ex.Message}";
            JsonValidationClass = "error";
        }
    }

    private void ValidateMetadataJson()
    {
        if (Item == null) return;

        try
        {
            JsonDocument.Parse(Item.MetadataJson ?? "{}");

            JsonValidationMsg = "✅ Valid JSON.";
            JsonValidationClass = "success";
        }
        catch (Exception ex)
        {
            JsonValidationMsg = $"❌ Invalid JSON: {ex.Message}";
            JsonValidationClass = "error";
        }
    }

    // ✅ UI HELPERS
    private void SetStatus(string message, string type)
    {
        StatusMessage = message;
        StatusClass = type;
        StatusIcon = type switch
        {
            "success" => "✅",
            "error" => "⛔",
            _ => "ℹ️"
        };
    }

    private string GetPublishStatusClass() =>
        Item?.IsArchived == true ? "archived" :
        Item?.IsPublished == true ? "published" : "unpublished";

    private string GetPublishStatusLabel() =>
        Item?.IsArchived == true ? "Archived" :
        Item?.IsPublished == true ? "Published" : "Draft";

    private string GetPublishBannerClass() =>
        Item?.IsArchived == true ? "archived" :
        Item?.IsPublished == true ? "" : "unpublished";

    private string GetPublishBannerIcon() =>
        Item?.IsArchived == true ? "🗄" :
        Item?.IsPublished == true ? "✅" : "⏳";

    private string GetPublishBannerSub() =>
        Item?.IsArchived == true ? "Archived" :
        Item?.IsPublished == true ? "Visible" :
        "Draft";

    // ✅ FILE TYPE
    private string GetFileTypeCss()
    {
        var mime = Item?.ContentType?.ToLower() ?? "";
        if (Item?.IsFolder == true) return "ft-folder";
        if (mime.Contains("pdf")) return "ft-pdf";
        if (mime.Contains("word")) return "ft-word";
        if (mime.Contains("excel")) return "ft-excel";
        if (mime.Contains("powerpoint")) return "ft-ppt";
        if (mime.Contains("video")) return "ft-video";
        if (mime.Contains("image")) return "ft-image";
        return "ft-other";
    }

    private string GetFileTypeIcon()
    {
        if (Item?.IsFolder == true) return "📁";
        var mime = Item?.ContentType?.ToLower() ?? "";
        if (mime.Contains("pdf")) return "📕";
        if (mime.Contains("word")) return "📘";
        if (mime.Contains("excel")) return "📗";
        if (mime.Contains("powerpoint")) return "📙";
        if (mime.Contains("video")) return "🎬";
        if (mime.Contains("image")) return "🖼️";
        return "📄";
    }

    private string GetFileTypeLabel()
    {
        if (Item?.IsFolder == true) return "Folder";
        var mime = Item?.ContentType?.ToLower() ?? "";
        if (mime.Contains("pdf")) return "PDF";
        if (mime.Contains("word")) return "Word";
        if (mime.Contains("excel")) return "Excel";
        if (mime.Contains("powerpoint")) return "PowerPoint";
        if (mime.Contains("video")) return "Video";
        if (mime.Contains("image")) return "Image";
        return "File";
    }

    private string GetActTypeIcon(string? type) => type?.ToLower() switch
    {
        "reading" => "📖",
        "video" => "🎬",
        "quiz" => "✅",
        "group" => "👥",
        "lab" => "🧪",
        "assignment" => "📝",
        _ => "📄"
    };

    private string FormatFileSize(long bytes)
    {
        if (bytes <= 0) return "—";
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F2} MB";
    }

    private async Task ViewDocument()
    {
        await JS.InvokeVoidAsync("open", $"/api/files/{ItemId}", "_blank");
    }
    
    public class CourseDropdownDto
    {
        public int Id { get; set; }
        public string Code { get; set; }
        public string Display { get; set; } = string.Empty;
    }

    public string GenerateCONTref()
    {
        var now = DateTime.UtcNow;

        return $"CONT-{now:yyyy-ddHHmmssfff}";
    }

    private void OnCourseChanged(object value)
    {
        if (Item == null) return;

        Item.CourseId = value?.ToString() ?? "";

        var course = courses.FirstOrDefault(c => c.CourseCode == Item.CourseId);

        if (course == null) return;

        var meta = new
        {
            courseCode = course.CourseCode,
            courseTitle = course.Title,
            courseDescription = StripHtml(course.Description)
        };

        Item.MetadataJson = JsonSerializer.Serialize(meta, new JsonSerializerOptions
        {
            WriteIndented = true
        });
    }

    private string StripHtml(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return "";

        // ✅ Remove HTML tags
        var text = System.Text.RegularExpressions.Regex.Replace(html, "<.*?>", string.Empty);

        // ✅ Decode HTML entities (&nbsp;, &#128216;, etc.)
        text = System.Net.WebUtility.HtmlDecode(text);

        // ✅ Optional: normalize spaces
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();

        return text;
    }
}

