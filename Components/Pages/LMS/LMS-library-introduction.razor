                                    <div class="col-12 col-sm-6">
                                        <div class="quick-card h-100">
                                            <div class="d-flex gap-3 align-items-start">
                                                <div class="info-icon compact"><i class="@step.Icon" aria-hidden="true"></i></div>
                                                <div>
                                                    <h3 class="h6 mb-1">@step.Title</h3>
                                                    <p class="mb-0 small-panel-copy">@step.Description</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </RadzenCard>
                    </div>
                </div>
            </div>
        </section>

        <section class="section-gap section-muted">
            <div class="container-xxl">
                <div class="section-heading">
                    <span class="eyebrow">Frequently Asked Questions</span>
