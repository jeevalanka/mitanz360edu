    private readonly IReadOnlyList<CrudPanel> CrudPanels =
    [
        new("Create", "fa-solid fa-circle-plus",
            [
                "Create folders using approved academy, course, module, and lesson naming conventions.",
                "Upload learning assets such as notes, decks, spreadsheets, PDFs, videos, images, code, and reference packages.",
                "Add metadata, tags, category, learning type, audience, visibility, and ownership at upload time.",
                "Create module or course resource collections aligned to outcomes and delivery structure."
            ]),
        new("Read", "fa-solid fa-eye",
            [
                "Browse structured folders or search by keyword, tag, owner, topic, or learning type.",
                "Preview supported files inside the platform before download or open-in-native-client actions.",
                "Inspect metadata, document history, and approval status before relying on the file for teaching or study.",
                "Use favorites and recent files to return to frequently used course resources quickly."
            ]),
        new("Update", "fa-solid fa-pen-to-square",
            [
                "Rename or move folders and documents when content architecture changes.",
                "Replace outdated resources while preserving history and documenting the version update clearly.",
                "Edit metadata, tags, category, learning outcomes, intended audience, and visibility where appropriate.",
                "Maintain clear ownership and current-state accuracy so search results remain trustworthy."
            ]),
        new("Delete", "fa-solid fa-trash-can",
            [
                "Remove duplicate, obsolete, or incorrectly published items only when policy and ownership allow.",
                "Use recoverable delete and recycle patterns rather than permanent destruction wherever governance requires restoration.",
                "Review dependencies before deletion when a file is linked to assessments, labs, or active modules.",
