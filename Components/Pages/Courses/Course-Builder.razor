@page "/course-builder"
@layout MainLayout_NoRightPan

@using System.Text.Json.Nodes
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Rendering
@using Radzen
@inject SharePointService SharePointService
@inject IWebHostEnvironment Env

<div class="app">

    <!-- ✅ DELETE MODAL -->
    @if (ShowDeleteConfirm)
    {
        <div class="overlay">
            <div class="confirm-box">
                <h3>Confirm Delete</h3>
                <p>Delete this course?</p>

                <div class="actions">
                    <RadzenButton Text="Cancel"
                                  Click="@((MouseEventArgs e) => CloseDeleteDialog())" />

                    <RadzenButton Text="Delete"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Click="@((MouseEventArgs e) => DeleteCourse())" />
                </div>
            </div>
        </div>
    }

    <!-- ✅ TOAST -->
    @if (ShowNotification)
    {
        <div class="toast">@SaveMessage</div>
    }

    <!-- ✅ HEADER -->
    <div class="header">

        <div class="left-header">
            <div class="title">AI Course Builder</div>

            <RadzenDropDown Data="@items"
                            TextProperty="Title"
                            ValueProperty="Id"
                            TValue="int?"
                            Value="@SelectedItemId"
                            ValueChanged="OnCourseChanged"
                            Style="width:220px"
                            Placeholder="Select Course" />
        </div>

        <div class="actions">
            <RadzenButton Text="New" Click="@LoadTemplate" />
            <RadzenButton Text="Save" Click="@SaveJson" />

            <RadzenButton Icon="delete"
                          Text="Delete"
                          ButtonStyle="ButtonStyle.Danger"
                          Click="@((MouseEventArgs e) => ConfirmDelete())"
                          Disabled="@(SelectedItemId == null)" />
        </div>
    </div>

    <!-- ✅ TABS -->
    <div class="tabs">
        @foreach (var section in JsonModel)
        {
            <button class="tab @(ActiveTab == section.Key ? "active" : "")"
                    @onclick="@(() => ActiveTab = section.Key)">
                @section.Key
            </button>
        }
    </div>

    <!-- ✅ FORM -->
    <div class="form-panel">
        @RenderActiveTab()
    </div>

</div>

<style>

    /* ✅ ROOT */
    .app {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background: #f3f2f1;
        font-family: "Segoe UI";
    }

    /* ✅ HEADER */
    .header {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        padding: 12px 16px;
        background: #fff;
        border-bottom: 1px solid #e1dfdd;
    }

    .left-header {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .actions {
        display: flex;
        gap: 8px;
    }

    /* ✅ TABS */
    .tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 10px;
        background: #fff;
    }

    .tab {
        padding: 6px 14px;
        border-radius: 16px;
        background: #e1dfdd;
        border: none;
    }

        .tab.active {
            background: #0078d4;
            color: white;
        }

    /* ✅ FORM GRID */
    .form-panel {
        padding: 16px;
    }

    /* ✅ KEY FIX — RESPONSIVE GRID */
    .group {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(280px,1fr));
        gap: 16px;
        background: #fff;
        padding: 16px;
        border-radius: 8px;
        margin-bottom: 16px;
    }

    /* ✅ FIELD */
    .field {
        display: flex;
        flex-direction: column;
    }

    .field-label {
        font-weight: 600;
        margin-bottom: 5px;
    }

    /* ✅ FORCE FULL WIDTH */
    .rz-textbox,
    .rz-dropdown {
        width: 100% !important;
    }

    /* ✅ MODAL */
    .overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.4);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .confirm-box {
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        width: 300px;
    }

    /* ✅ TOAST */
    .toast {
        position: fixed;
        top: 20px;
        right: 20px;
        background: #28a745;
        color: white;
        padding: 10px;
        border-radius: 6px;
    }

    /* ✅ MOBILE */
    @@media(max - width:600px) {
        .group {
            grid-template-columns: 1fr;
        }
    }

</style>

@code {

    private List<AIRepositoryItem> items = new();
    private JsonObject JsonModel = new();
    private string ActiveTab = "";

    private int? SelectedItemId;

    private bool ShowDeleteConfirm;
    private bool ShowNotification;
    private string SaveMessage;

    protected override async Task OnInitializedAsync()
    {
        items = await SharePointService.GetAIRepositoryItemsAsync(orderBy: "id desc");
        LoadTemplate();
    }

    private void OnCourseChanged(int? id)
    {
        SelectedItemId = id;

        if (id.HasValue)
        {
            var item = items.FirstOrDefault(x => x.Id == id);

            if (item != null)
            {
                JsonModel = JsonNode.Parse(item.Metadata)?.AsObject() ?? new();
                ActiveTab = JsonModel.FirstOrDefault().Key ?? "";
            }
        }
    }

    private void LoadTemplate()
    {
        var path = Path.Combine(Env.WebRootPath, "Data", "template.json");

        JsonModel = JsonNode.Parse(File.ReadAllText(path))?.AsObject() ?? new();
        ActiveTab = JsonModel.FirstOrDefault().Key ?? "";

        SelectedItemId = null;
    }

    private async Task SaveJson()
    {
        var name = JsonModel?["CourseSetup"]?["CourseDetails"]?["CourseName"]?.ToString() ?? "Untitled";

        await SharePointService.CreateAIRepositoryItemAsync(new AIRepositoryItem
        {
            Title = name,
            Metadata = JsonModel.ToJsonString()
        });

        SaveMessage = "✅ Saved";
        ShowNotification = true;
        await Task.Delay(2000);
        ShowNotification = false;
    }

    private void ConfirmDelete()
    {
        Console.WriteLine("✅ Confirm clicked");
        ShowDeleteConfirm = true;
    }

    private void CloseDeleteDialog()
    {
        ShowDeleteConfirm = false;
    }

    private async Task DeleteCourse()
    {
        if (!SelectedItemId.HasValue) return;

        Console.WriteLine($"Deleting {SelectedItemId}");

        await SharePointService.DeleteAIRepositoryItemAsync(SelectedItemId.Value);

        items = await SharePointService.GetAIRepositoryItemsAsync(orderBy: "id desc");

        LoadTemplate();

        SaveMessage = "🗑 Deleted";
        ShowNotification = true;

        ShowDeleteConfirm = false;

        await Task.Delay(2000);
        ShowNotification = false;
    }

    private RenderFragment RenderActiveTab() => builder =>
    {
        if (!JsonModel.ContainsKey(ActiveTab)) return;

        int seq = 0;
        RenderNode(builder, ref seq, JsonModel[ActiveTab], JsonModel, ActiveTab);
    };

    private void RenderNode(RenderTreeBuilder b, ref int seq, JsonNode node, JsonObject parent, string key)
    {
        if (node is JsonObject obj)
        {
            foreach (var kv in obj)
            {
                b.OpenElement(seq++, "div");
                b.AddAttribute(seq++, "class", "group");

                RenderNode(b, ref seq, kv.Value, obj, kv.Key);

                b.CloseElement();
            }
        }
        else if (node is JsonValue val)
        {
            b.OpenElement(seq++, "div");
            b.AddAttribute(seq++, "class", "field");

            b.OpenElement(seq++, "div");
            b.AddAttribute(seq++, "class", "field-label");
            b.AddContent(seq++, key);
            b.CloseElement();

            b.OpenComponent<RadzenTextBox>(seq++);
            b.AddAttribute(seq++, "Value", val.ToString());
            b.AddAttribute(seq++, "Change",
                EventCallback.Factory.Create<string>(this, v => parent[key] = v));
            b.CloseComponent();

            b.CloseElement();
        }
    }
}