        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: nowrap;
        padding: 12px 16px;
        background: #008000;
        border-bottom: 1px solid #e1dfdd;
        gap: 16px;
    }

    .left-header {
        display: flex;
