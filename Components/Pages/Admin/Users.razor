@page "/users"
@layout MainLayout


@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Radzen
@using Radzen.Blazor

@using MITANZ360Edu.Web.Data
@using MITANZ360Edu.Web.Models
@using MITANZ360Edu.Web.Services

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IServiceScopeFactory ScopeFactory
@inject NotificationService NotificationService
@inject SharePointService SharePointService

<PageTitle>User Management</PageTitle>

<div class="container mt-4 page-wrap">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <div class="top-card mb-3">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div>

                <h3 class="title mb-1">
                    User Management
                </h3>

                <div class="subtle">
                    Manage users, roles and status access.
                </div>

            </div>

            <div class="d-flex gap-2 flex-wrap">

                <RadzenTextBox @bind-Value="search"
                               Placeholder="Search users..."
                               Style="width:300px;" />

                <RadzenButton Text="New User"
                              Icon="person_add"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="OpenCreateUserBlade" />

            </div>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- USERS -->
    <!-- ===================================================== -->

    <div class="row g-3">

        @foreach (var u in FilteredUsers())
        {
            <div class="col-12 col-md-6 col-xl-4">

                <RadzenCard class="nice-card p-3">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <h5 class="mb-1">
                                @DisplayName(u)
                            </h5>

                            <div class="subtle">
                                @u.Email
                            </div>

                            <div class="mt-2">

                                <RadzenBadge Text="@(IsActive(u) ? "ACTIVE" : "LOCKED")"
                                             Style="@(IsActive(u)
                                                                                                                              ? "background:#16a34a;color:white;"
                                                                                                                              : "background:#dc2626;color:white;")" />

                            </div>

                            <div class="mt-2">

                                <span class="pill">

                                    @string.Join(
                                        ", ",
                                        userRoles.TryGetValue(
                                            u.Id,
                                            out var rr)
                                                ? rr
                                                : new List<string>())

                                </span>

                            </div>

                        </div>

                        <RadzenButton Icon="edit"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Click="@(async () => await OpenEditUserBlade(u))" />

                    </div>

                    <!-- ACTIONS -->

                    <div class="mt-3 d-flex gap-2 flex-wrap">

                        @if (IsActive(u))
                        {
                            <RadzenButton Text="Hold"
                                          Icon="pause_circle"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Warning"
                                          Disabled="@busy"
                                          Click="@(async () => await AskStatusChange(u, UserStatus.Hold))" />

                            <RadzenButton Text="Disable"
                                          Icon="block"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Disabled="@busy"
                                          Click="@(async () => await AskStatusChange(u, UserStatus.Disabled))" />
                        }
                        else
                        {
                            <RadzenButton Text="Enable"
                                          Icon="check_circle"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Success"
                                          Disabled="@busy"
                                          Click="@(async () => await AskStatusChange(u, UserStatus.Active))" />
                        }

                    </div>

                </RadzenCard>

            </div>
        }

    </div>

</div>

<!-- ===================================================== -->
<!-- USER SIDE PANEL -->
<!-- ===================================================== -->

<RadzenSidebar Position="SidebarPosition.Right"
               Visible="@showUserBlade"
               Class="mit-blade">

    <div class="blade-header">

        <div class="d-flex align-items-center gap-2">

            <RadzenIcon Icon="@userBladeIcon"
                        Style="@($"color:{userBladeIconColor};")" />

            <h4 class="mb-0">
                @userBladeTitle
            </h4>

        </div>

        <RadzenButton Icon="close"
                      Size="ButtonSize.Small"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@CloseUserBlade" />

    </div>

    <div class="blade-body">

        <div class="row">

            <div class="col-md-6 mb-3">

                <RadzenLabel Text="Username" />

                <RadzenTextBox @bind-Value="model.UserName"
                               Style="width:100%;" />

            </div>

            <div class="col-md-6 mb-3">

                <RadzenLabel Text="Email" />

                <RadzenTextBox @bind-Value="model.Email"
                               Style="width:100%;" />

            </div>

            <div class="col-md-6 mb-3">

                <RadzenLabel Text="Phone" />

                <RadzenTextBox @bind-Value="model.PhoneNumber"
                               Style="width:100%;" />

            </div>

            <div class="col-md-6 mb-3">

                <RadzenLabel Text="Status" />

                <RadzenDropDown TValue="UserStatus"
                                Data="@statusEnumValues"
                                @bind-Value="model.Status"
                                Style="width:100%;" />

            </div>

            <div class="col-12 mb-3">

                <RadzenLabel Text="Roles" />

                <RadzenDropDownDataGrid TValue="List<string>"
                                        Data="@allRoles"
                                        TextProperty="Title"
                                        ValueProperty="Title"
                                        Multiple="true"
                                        Chips="true"
                                        AllowFiltering="true"
                                        @bind-Value="model.Roles"
                                        Style="width:100%;" />

            </div>

            <div class="col-md-6 mb-3">

                <RadzenLabel Text="Password" />

                <RadzenPassword @bind-Value="model.Password"
                                Style="width:100%;" />

            </div>

            <div class="col-md-6 mb-3">

                <RadzenLabel Text="Confirm Password" />

                <RadzenPassword @bind-Value="model.ConfirmPassword"
                                Style="width:100%;" />

            </div>

        </div>

    </div>

    <div class="blade-footer">

        <RadzenButton Text="Cancel"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@CloseUserBlade"
                      Disabled="@busy" />

        <RadzenButton Text="Save"
                      Icon="save"
                      ButtonStyle="ButtonStyle.Primary"
                      Disabled="@busy"
                      Click="AskSaveUser" />

    </div>

</RadzenSidebar>

@code {

    // =====================================================
    // ENUM
    // =====================================================

    private enum UserStatus
    {
        Active,
        Hold,
        Disabled
    }

    private IReadOnlyList<UserStatus>
        statusEnumValues =
            Enum.GetValues<UserStatus>();

    // =====================================================
    // STATE
    // =====================================================

    private List<ApplicationUser>
        users = new();

    private List<AppRoleModel>
        allRoles = new();

    private Dictionary<string, List<string>>
        userRoles = new();

    private bool showUserBlade;
    private bool busy;
    private bool isEditMode;

    private string search = "";

    private string userBladeTitle = "New User";
    private string userBladeIcon = "person_add";
    private string userBladeIconColor = "#2563eb";

    private ApplicationUser?
        editingUser;

    private CreateEditUserModel
        model = new();

    // =====================================================
    // INITIALIZE
    // =====================================================

    protected override async Task
        OnInitializedAsync()
    {
        await LoadUsersAndRoleMap();

        await LoadRoles();
    }

    // =====================================================
    // LOAD ROLES
    // =====================================================

    private async Task
        LoadRoles()
    {
        try
        {
            allRoles =
                await SharePointService
                    .GetRolesAsync();

            allRoles =
                allRoles
                    .Where(x => x.IsActive)
                    .OrderBy(x => x.Title)
                    .ToList();
        }
        catch (Exception ex)
        {
            Notify(
                ex.Message,
                NotificationSeverity.Error);
        }
    }

    // =====================================================
    // LOAD USERS
    // =====================================================

    private async Task
        LoadUsersAndRoleMap()
    {
        await using var db =
            await DbFactory
                .CreateDbContextAsync();

        users =
            await db.Users
                .AsNoTracking()
                .OrderBy(x => x.UserName)
                .ToListAsync();

        var pairs =
            await (
                from ur in db.UserRoles
                join r in db.Roles
                    on ur.RoleId equals r.Id
                select new
                {
                    ur.UserId,
                    RoleName = r.Name
                }
            )
            .AsNoTracking()
            .ToListAsync();

        userRoles =
            pairs
                .Where(x => !string.IsNullOrWhiteSpace(x.RoleName))
                .GroupBy(x => x.UserId)
                .ToDictionary(
                    g => g.Key,
                    g => g.Select(x => x.RoleName!)
                          .Distinct()
                          .OrderBy(x => x)
                          .ToList());
    }

    // =====================================================
    // FILTER
    // =====================================================

    private IEnumerable<ApplicationUser>
        FilteredUsers()
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            return users;
        }

        var s =
            search
                .Trim()
                .ToLowerInvariant();

        return users.Where(u =>
            (u.UserName ?? "")
                .ToLowerInvariant()
                .Contains(s)
            ||
            (u.Email ?? "")
                .ToLowerInvariant()
                .Contains(s));
    }

    // =====================================================
    // DISPLAY
    // =====================================================

    private string
        DisplayName(
            ApplicationUser u)
        => u.UserName ?? "(no username)";

    private bool
        IsActive(
            ApplicationUser u)
        =>
            u.LockoutEnd == null
            ||
            u.LockoutEnd <= DateTimeOffset.UtcNow;

    // =====================================================
    // CREATE
    // =====================================================

    private async Task
        OpenCreateUserBlade()
    {
        await LoadRoles();

        isEditMode = false;

        editingUser = null;

        model =
            new CreateEditUserModel
            {
                Status = UserStatus.Active,
                Roles = []
            };

        userBladeTitle = "New User";
        userBladeIcon = "person_add";

        showUserBlade = true;
    }

    // =====================================================
    // EDIT
    // =====================================================

    private async Task
        OpenEditUserBlade(
            ApplicationUser u)
    {
        await LoadRoles();

        isEditMode = true;

        editingUser = u;

        var roles =
            userRoles.TryGetValue(
                u.Id,
                out var r)
                    ? r
                    : [];

        model =
            new CreateEditUserModel
            {
                Id = u.Id,
                UserName = u.UserName ?? "",
                Email = u.Email ?? "",
                PhoneNumber = u.PhoneNumber,
                Roles = roles.ToList(),
                Status =
                    IsActive(u)
                        ? UserStatus.Active
                        : UserStatus.Disabled
            };

        userBladeTitle = "Edit User";
        userBladeIcon = "manage_accounts";

        showUserBlade = true;
    }

    // =====================================================
    // SAVE USER
    // =====================================================

    private async Task
        AskSaveUser()
    {
        try
        {
            busy = true;

            using var scope =
                ScopeFactory.CreateScope();

            var userManager =
                scope.ServiceProvider
                    .GetRequiredService<
                        UserManager<ApplicationUser>>();

            var roleManager =
                scope.ServiceProvider
                    .GetRequiredService<
                        RoleManager<IdentityRole>>();

            if (!isEditMode)
            {
                var user =
                    new ApplicationUser
                    {
                        UserName = model.UserName,
                        Email = model.Email,
                        PhoneNumber = model.PhoneNumber,
                        EmailConfirmed = true
                    };

                var createResult =
                    await userManager
                        .CreateAsync(
                            user,
                            model.Password);

                if (!createResult.Succeeded)
                {
                    Notify(
                        string.Join(
                            ", ",
                            createResult.Errors
                                .Select(x => x.Description)),
                        NotificationSeverity.Error);

                    return;
                }

                await userManager
                    .AddToRolesAsync(
                        user,
                        model.Roles);

                Notify("User created");
            }
            else
            {
                var user =
                    await userManager
                        .FindByIdAsync(
                            model.Id!);

                if (user == null)
                {
                    Notify(
                        "User not found",
                        NotificationSeverity.Error);

                    return;
                }

                user.UserName = model.UserName;
                user.Email = model.Email;
                user.PhoneNumber = model.PhoneNumber;

                await userManager
                    .UpdateAsync(user);

                var currentRoles =
                    await userManager
                        .GetRolesAsync(user);

                await userManager
                    .RemoveFromRolesAsync(
                        user,
                        currentRoles);

                await userManager
                    .AddToRolesAsync(
                        user,
                        model.Roles);

                Notify("User updated");
            }

            showUserBlade = false;

            await LoadUsersAndRoleMap();

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Notify(
                ex.Message,
                NotificationSeverity.Error);
        }
        finally
        {
            busy = false;

            await InvokeAsync(StateHasChanged);
        }
    }

    // =====================================================
    // STATUS CHANGE
    // =====================================================

    private async Task
        AskStatusChange(
            ApplicationUser u,
            UserStatus status)
    {
        try
        {
            busy = true;

            using var scope =
                ScopeFactory.CreateScope();

            var userManager =
                scope.ServiceProvider
                    .GetRequiredService<
                        UserManager<ApplicationUser>>();

            var user =
                await userManager
                    .FindByIdAsync(u.Id);

            if (user == null)
            {
                Notify(
                    "User not found",
                    NotificationSeverity.Error);

                return;
            }

            if (status == UserStatus.Active)
            {
                user.LockoutEnabled = false;
                user.LockoutEnd = null;

                await userManager.UpdateAsync(user);

                Notify("User enabled");
            }
            else if (status == UserStatus.Hold)
            {
                user.LockoutEnabled = true;

                user.LockoutEnd =
                    DateTimeOffset.UtcNow.AddDays(7);

                await userManager.UpdateAsync(user);

                Notify("User placed on hold");
            }
            else
            {
                user.LockoutEnabled = true;

                user.LockoutEnd =
                    DateTimeOffset.MaxValue;

                await userManager.UpdateAsync(user);

                Notify("User disabled");
            }

            await LoadUsersAndRoleMap();

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Notify(
                ex.Message,
                NotificationSeverity.Error);
        }
        finally
        {
            busy = false;

            await InvokeAsync(StateHasChanged);
        }
    }

    // =====================================================
    // CLOSE
    // =====================================================

    private void
        CloseUserBlade()
    {
        showUserBlade = false;
    }

    // =====================================================
    // NOTIFY
    // =====================================================

    private void
        Notify(
            string message,
            NotificationSeverity severity =
                NotificationSeverity.Success)
    {
        NotificationService.Notify(
            new NotificationMessage
            {
                Severity = severity,
                Summary = message,
                Duration = 3000
            });
    }

    // =====================================================
    // MODEL
    // =====================================================

    private class CreateEditUserModel
    {
        public string? Id { get; set; }

        public string UserName { get; set; }
            = "";

        public string Email { get; set; }
            = "";

        public string? PhoneNumber { get; set; }

        public UserStatus Status { get; set; }
            = UserStatus.Active;

        public List<string> Roles { get; set; }
            = [];

        public string Password { get; set; }
            = "";

        public string ConfirmPassword { get; set; }
            = "";
    }
}