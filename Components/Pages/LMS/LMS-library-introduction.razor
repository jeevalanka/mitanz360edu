@page "/lms-library-introduction"
@layout Lib_Cont_Layout
@attribute [Authorize(Roles = "Admin,SysAdmin,Trainer")]

@using Microsoft.AspNetCore.Components
@using Radzen.Blazor

<PageTitle>MITANZ360Edu AI Learning Hub | LMS Library Viewer</PageTitle>

@code {
