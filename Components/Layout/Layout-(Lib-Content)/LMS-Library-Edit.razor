
@page "/lms-crud-edit/{Id}/{FolderId}"
@layout Lib_Cont_Layout

@using MITANZ360Edu.Web.Services
@using MITANZ360Edu.Web.Services.Automation
@using MITANZ360Edu.Web.Models

@using Radzen
@using Radzen.Blazor
@using System.Text.Json
@using System.Text.Json.Nodes
@using System.Text.RegularExpressions;
@using HtmlAgilityPack;
@using System.Net;

@inject SharePointService SharePointService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject IJSRuntime JS
@inject Radzen.DialogService DialogService
@inject JsonLookupDataService JsonLookupDataService
@inject AutomationService AutomationService


<PageTitle>LMS Content Edit</PageTitle>

<!-- ===================================================== -->
<!-- PAGE -->
<!-- ===================================================== -->

<div style="
    min-height:100vh;
    padding:28px;
    background:
    linear-gradient(
    135deg,
    #f3f6fb,
    #eef3f8);">

    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <RadzenCard Style="
        border-radius:30px;
        padding:10px;
        margin-bottom:14px;
        background:
        linear-gradient(
        135deg,
        blue,
        #0078D4,
        black);
        color:white;
        box-shadow:
        0 10px 20px rgba(0,0,0,0.16);">

        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.SpaceBetween">

            <div>
                <RadzenText TextStyle="TextStyle.H6" Style="font-weight:700; color:white;">
                    LMS Content Editor
                </RadzenText>
            </div>

            <RadzenButton Icon="arrow_back"
                          Text="Back"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@BackToLibrary"
                          Style="
            border-radius:16px;
            height:18px;
            padding-left:10px;
            padding-right:20px;
            font-weight:800;" />

        </RadzenStack>

    </RadzenCard>

    <!-- ================================================= -->
    <!-- MAIN GRID -->
    <!-- ================================================= -->

    <RadzenRow Gap="1rem">

        <!-- ============================================= -->
        <!-- LEFT -->
        <!-- ============================================= -->

        <RadzenColumn Size="8">

            <!-- GENERAL -->

            <RadzenCard Style="@GlassCardStyle">
                <RadzenStack Gap="1.25rem">
                    <RadzenText TextStyle="TextStyle.H5" Style="@SectionHeaderStyle">
                        General Information
                    </RadzenText>

                    <div class="lms-inline-fields">
                        <RadzenTextBox @bind-Value="Model.ContentId"
                                       Placeholder="Content ID"
                                       Style="width:50%;"
                                       ReadOnly="true"
                                       Title="System generated enterprise content identifier." />

                        <RadzenTextBox @bind-Value="Model.CourseId"
                                       Placeholder="Course ID"
                                       Style="width:50%;"
                                       ReadOnly="true"
                                       Title="Associated LMS course identifier." />
                    </div>

                    <RadzenTextBox @bind-Value="Model.Title"
                                   Placeholder="Title"
                                   Style="@InputStyle"
                                   Title="Main learning content title displayed in the LMS." />

                    <RadzenTextArea @bind-Value="Model.Description"
                                    Placeholder="Description"
                                    Rows="5"
                                    Style="@InputStyle"
                                    Title="Detailed summary or overview of the learning content." />

                </RadzenStack>
            </RadzenCard>

            <!-- EXTENDED METADATA -->

            <RadzenCard Style="@GlassCardStyle">
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H5"
                                Style="@SectionHeaderStyle">
                        Extended Metadata
                    </RadzenText>

                    <RadzenTextArea @bind-Value="Model.MetadataJson"
                                    Rows="10"
                                    Style="@InputStyle"
                                    Title="Structured metadata information stored in JSON format." />
                </RadzenStack>
            </RadzenCard>

            <!-- AI -->

<RadzenCard Style="@AiCardStyle">
    <RadzenStack Gap="1rem">

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" AlignItems="AlignItems.Center">
            <RadzenIcon Icon="psychology" Style=" font-size:28px; color:#0078D4;" />
            <RadzenText TextStyle="TextStyle.H5" Style="@SectionHeaderStyle">
                AI Intelligence Feed
            </RadzenText>

            <RadzenButton Icon="psychology"
              Text="Generate AI Feedback"
              ButtonStyle="ButtonStyle.Primary"
              Click="@GenerateAIFeedbackAsync"
               Disabled="@(DisableAi || IsLoading)"
               Busy="@IsLoading"
              BusyText="AI Processing..." />

        </RadzenStack>

        <!-- ✅ ADD HERE -->
        @if (IsOcrRequired)
        {
            <div style="color:red; font-weight:600;">
                This file requires OCR (image or scanned document). AI evaluation is disabled.
            </div>
        }

        <!-- AI OUTPUT -->
        <RadzenTextArea @bind-Value="Model.AiFeed"
                        Rows="10"
                        Style="@InputStyle"
                        Title="AI-generated summaries, intelligence insights, or recommendations." />

    </RadzenStack>
</RadzenCard>
        </RadzenColumn>

        <!-- ============================================= -->
        <!-- RIGHT -->
        <!-- ============================================= -->

        <RadzenColumn Size="4">
            <!-- METADATA -->
            <RadzenCard Style="@GlassCardStyle">

                <RadzenStack Gap="1rem">

                    <RadzenText TextStyle="TextStyle.H5" Style="@SectionHeaderStyle">
                        METADATA
                    </RadzenText>

                    <!-- Select Country -->
                    <RadzenDropDown Data="@Countries"
                                    TValue="string"
                                    TextProperty="Name"
                                    ValueProperty="Code"
                                    @bind-Value="SelectedCountry"
                                    Change="OnCountryChanged"
                                    Placeholder="Select Country"
                                    AllowClear="true"
                                    Style="@InputStyle"
                                    Title="Country associated with this learning content." />
                    <!-- Select Course -->
                    <RadzenDropDown TValue="string"
                                    Data="@Courses"
                                    TextProperty="Title"
                                    ValueProperty="CourseCode"
                                    @bind-Value="Model.CourseId"
                                    Change="@OnCourseChanged"
                                    Placeholder="Select Course"
                                    Style="@InputStyle"
                                    Title="Select the linked LMS course." />

                </RadzenStack>

            </RadzenCard>
            <!-- GOVERNANCE -->
            <RadzenCard Style="@GlassCardStyle">

                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H5"
                                Style="@SectionHeaderStyle">
                        Governance
                    </RadzenText>

                    <!-- CONTENT TYPE -->
                    <RadzenDropDown Data="@ContentTypeOptions"
                                    TValue="string"
                                    @bind-Value="Model.ContentType"
                                    Placeholder="Content Type"
                                    Style="@InputStyle"
                                    Title="Defines the category or type of learning content." />

                    <!-- SOURCE -->
                    <RadzenDropDown Data="@SourceTypeOptions"
                                    TValue="string"
                                    @bind-Value="Model.Source"
                                    Placeholder="Source"
                                    Style="@InputStyle"
                                    Title="Indicates where the content originated from." />

                    <RadzenDropDown Data="@CourseModelTypeOptions"
                                    TValue="string"
                                    @bind-Value="Model.CourseModel"
                                    Placeholder="Select Course Model"
                                    Style="@InputStyle"
                                    Title="Associated learning model or curriculum structure." />

                    <!-- PUBLISHED -->
                    <RadzenCard Style="
                        border-radius:18px;
                        padding:18px;
                        background:
                        rgba(255,255,255,0.55);">

                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.SpaceBetween">

                            <div>
                                <RadzenText TextStyle="TextStyle.Body1">
                                    Published
                                </RadzenText>

                                <RadzenText TextStyle="TextStyle.Caption">
                                    Enable learner visibility
                                </RadzenText>
                            </div>

                            <RadzenSwitch @bind-Value="Model.IsPublished" />

                        </RadzenStack>

                    </RadzenCard>

                    <!-- ARCHIVED -->
                    <RadzenCard Style="
                        border-radius:18px;
                        padding:18px;
                        background:
                        rgba(255,255,255,0.55);">

                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.SpaceBetween">
                            <div>
                                <RadzenText TextStyle="TextStyle.Body1">
                                    Archived
                                </RadzenText>

                                <RadzenText TextStyle="TextStyle.Caption">
                                    Remove from active usage
                                </RadzenText>
                            </div>
                            <RadzenSwitch @bind-Value="Model.IsArchived" />
                        </RadzenStack>
                    </RadzenCard>
                </RadzenStack>

            </RadzenCard>
            <!-- QUICK INFO -->
            <RadzenCard Style="@GlassCardStyle">

                <RadzenStack Gap="0.75rem">

                    <RadzenText TextStyle="TextStyle.H5"
                                Style="@SectionHeaderStyle">

                        Quick Info

                    </RadzenText>

                    <div>
                        <b>File:</b> @Model.Name
                    </div>

                    <div>
                        <b>Modified:</b> @Model.LastModified?.LocalDateTime.ToString("g")

                    </div>

                    <div>
                        <b>Size:</b>
                        @FormatBytes(Model.Size)
                    </div>

                </RadzenStack>

            </RadzenCard>
        </RadzenColumn>

    </RadzenRow>

    <!-- ================================================= -->
    <!-- STICKY ACTION BAR -->
    <!-- ================================================= -->

    <div style="
        position:sticky;
        bottom:0;
        margin-top:18px;
        padding:10px;
        border-radius:30px;
        background: #d1d5db;
        backdrop-filter:blur(18px);
        box-shadow: 0 10px 30px rgba(0,0,0,1.0);">

        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.End"
                     Gap="0.5rem">

            <RadzenButton ButtonStyle="ButtonStyle.Primary"
                          Icon="save"
                          Text="Save Changes"
                          Click="@SaveAsync"
                          Style="@ActionButtonStyle" />

            <RadzenButton Icon="delete"
                          Text="Delete"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@ConfirmDeleteAsync"
                          Style="@ActionButtonStyle" />

            <RadzenButton Icon="open_in_new"
                          Text="Open Online"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@OpenOnline"
                          Style="@ActionButtonStyle" />

            <RadzenButton ButtonStyle="ButtonStyle.Warning"
                          Icon="close"
                          Text="Cancel"
                          Click="@BackToLibrary"
                          Style="@ActionButtonStyle" />

        </RadzenStack>

    </div>

</div>

@code {

    [Parameter] public string Id { get; set; } = string.Empty;
    [Parameter] public string FolderId { get; set; } = "root";

    private LibraryItem Model = new();
    private IReadOnlyList<CourseModel> Courses = [];
    private bool HasReadableContent = true;

    private List<JsonLookupDataService.CountryModel> Countries = [];
    private List<ContentType> ContentTypeOptions = Enum.GetValues<ContentType>().ToList();
    private List<SourceType> SourceTypeOptions = Enum.GetValues<SourceType>().ToList();
    private List<CourseModelType> CourseModelTypeOptions = Enum.GetValues<CourseModelType>().ToList();

    private string? SelectedCountry;
    private bool IsLoading;
    private bool IsOcrRequired => IsImageFile(Model?.Name);
    private bool DisableAi => IsOcrRequired; // you can extend later


    // =========================
    // STYLES
    // =========================

    private const string GlassCardStyle = "border-radius:20px;padding:20px;margin-bottom:16px;";
    private const string AiCardStyle = "border-radius:20px;padding:20px;background:#f5faff;margin-bottom:16px;";
    private const string InputStyle = "width:100%;border-radius:10px;";
    private const string SectionHeaderStyle = "font-weight:600;";
    private const string ActionButtonStyle = "margin:5px;";

    // =========================
    // LOAD
    // =========================

    protected override async Task OnParametersSetAsync()
    {
        Courses = await SharePointService.GetCoursesAsync();
        Countries = await JsonLookupDataService.GetCountriesAsync();

        if (string.IsNullOrWhiteSpace(Id))
        {
            Model = new LibraryItem
            {
                ContentId = SharePointService.GenerateContentId(),
                IsPublished = true,
                Source = "Internal"
            };

            // ✅ NEW ITEM → set location
            await DetectAndSetCountryAsync();

            return;
        }

        var driveId = await SharePointService.GetPublicLmsDriveIdAsync();
        var item = await SharePointService.GetItemAsync(driveId, Id);

        if (item == null)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Not Found", "Document not found");
            return;
        }

        Model = item;

        // ✅ EXISTING ITEM → apply location AFTER load
        await DetectAndSetCountryAsync();
    }
    // =========================
    // SAVE
    // =========================

    private async Task SaveAsync()
    {
        var driveId = await SharePointService.GetPublicLmsDriveIdAsync();

        await SharePointService.UpdateLibraryItemAsync(driveId, Id, Model);

        NotificationService.Notify(NotificationSeverity.Success, "Saved", "Changes saved");

        NavigationManager.NavigateTo("/lms-library-introduction");
    }

    // =========================
    // BACK
    // =========================

    private void BackToLibrary()
    {
        NavigationManager.NavigateTo("/lms-library-introduction");
    }

    // =========================
    // DELETE
    // =========================

    private async Task ConfirmDeleteAsync()
    {
        var confirmed = await DialogService.Confirm(
            "Delete item?",
            "Confirm",
            new ConfirmOptions { OkButtonText = "Delete" });

        if (confirmed == true)
        {
            await DeleteAsync();
        }
    }

    private async Task DeleteAsync()
    {
        await SharePointService.DeleteItemAsync(Model.DriveId, Model.Id);

        NotificationService.Notify(NotificationSeverity.Success, "Deleted");

        NavigationManager.NavigateTo("/lms-library");
    }

    // =========================
    // OPEN
    // =========================

    private async Task OpenOnline()
    {
        if (!string.IsNullOrWhiteSpace(Model.WebUrl))
        {
            await JS.InvokeVoidAsync("open", Model.WebUrl, "_blank");
        }
    }

    // =========================
    // FORMAT
    // =========================

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "0 B";

        string[] sizes = ["B", "KB", "MB", "GB"];
        var order = (int)Math.Log(bytes, 1024);

        return $"{bytes / Math.Pow(1024, order):0.##} {sizes[order]}";
    }

    // =========================
    // COUNTRY CHANGE
    // =========================

    private void OnCountryChanged(object value)
    {
        var isoCode = value?.ToString();
        var selected = Countries.FirstOrDefault(x => x.Code == isoCode);

        if (selected == null) return;

        SelectedCountry = isoCode;

        Dictionary<string, object> metadata;

        try
        {
            metadata = string.IsNullOrWhiteSpace(Model.MetadataJson)
                ? []
                : JsonSerializer.Deserialize<Dictionary<string, object>>(Model.MetadataJson) ?? [];
        }
        catch
        {
            metadata = [];
        }

        metadata["CountryCode"] = selected.Code;
        metadata["CountryName"] = selected.Name;

        Model.MetadataJson = JsonSerializer.Serialize(metadata, new JsonSerializerOptions { WriteIndented = true });
    }

    // =========================
    // COURSE CHANGE
    // =========================

    private void OnCourseChanged(object value)
    {
        var code = value?.ToString();
        var selected = Courses.FirstOrDefault(x => x.CourseCode == code);

        if (selected == null) return;

        Model.CourseId = selected.CourseCode;

        Dictionary<string, object> metadata;

        try
        {
            metadata = string.IsNullOrWhiteSpace(Model.MetadataJson)
                ? []
                : JsonSerializer.Deserialize<Dictionary<string, object>>(Model.MetadataJson) ?? [];
        }
        catch
        {
            metadata = [];
        }

        metadata["CourseId"] = selected.CourseCode;
        metadata["CourseTitle"] = selected.Title;
        metadata["CourseDescription"] = HtmlToText(selected.Description);
        metadata["CourseLearningOutcomes"] = HtmlToText(selected.LearningOutcomes);

        Model.MetadataJson = JsonSerializer.Serialize(metadata, new JsonSerializerOptions { WriteIndented = true });
    }

    // =========================
    // AI (FIXED)
    // =========================

    private async Task GenerateAIFeedbackAsync()
    {
        if (IsLoading || (DisableAi || IsOcrRequired))
            return;

        try
        {
            IsLoading = true;

            // ✅ STEP 1: Parse metadata JSON
            Dictionary<string, string> metadata;

            try
            {
                metadata = string.IsNullOrWhiteSpace(Model.MetadataJson)
                    ? new Dictionary<string, string>()
                    : JsonSerializer.Deserialize<Dictionary<string, string>>(Model.MetadataJson)
                      ?? new Dictionary<string, string>();
            }
            catch
            {
                metadata = new Dictionary<string, string>();
            }

            // ✅ STEP 2: Clean HTML in metadata
            if (metadata.ContainsKey("CourseDescription"))
                metadata["CourseDescription"] = HtmlToText(metadata["CourseDescription"]);

            if (metadata.ContainsKey("CourseLearningOutcomes"))
                metadata["CourseLearningOutcomes"] = HtmlToText(metadata["CourseLearningOutcomes"]);

            // ✅ STEP 3: DOWNLOAD FILE STREAM FROM SHAREPOINT
            using var stream = await SharePointService
                .DownloadFileAsync(Model.DriveId, Model.Id);

            string fileContent = string.Empty;

            // ✅ STEP 4: EXTRACT TEXT USING YOUR ENGINE
            if (stream != null)
            {
                try
                {
                    fileContent = await SharePointService
                        .ExtractTextAsync(Model.Name, stream);
                }
                catch
                {
                    fileContent = string.Empty;
                }
            }

            // ✅ STEP 5: FALLBACK (IMPORTANT)
            if (string.IsNullOrWhiteSpace(fileContent))
            {
                fileContent = $"{Model.Title}\n\n{Model.Description}";
            }

            // ✅ STEP 6: CALL AI
            var aiText = await AutomationService.GenerateAIFeedbackAsync(
                metadata,
                fileContent);

            // ✅ STEP 7: SET RESULT
            Model.AiFeed = aiText;

            NotificationService.Notify(
                NotificationSeverity.Success,
                "AI Feedback generated");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                "AI Failed",
                ex.Message);
        }
        finally
        {
            IsLoading = false;
        }
    }
    // =========================
    // HTML FIX (UPGRADED)
    // =========================

    private static string HtmlToText(string? html)
    {
        if (string.IsNullOrWhiteSpace(html))
            return string.Empty;

        var doc = new HtmlDocument();
        doc.LoadHtml(html);

        var brNodes = doc.DocumentNode.SelectNodes("//br");

        if (brNodes != null)
        {
            foreach (var node in brNodes)
            {
                node.ParentNode?.ReplaceChild(
                    doc.CreateTextNode(Environment.NewLine),
                    node);
            }
        }

        var textNodes = doc.DocumentNode.SelectNodes("//p|//div|//li|//h1|//h2|//h3|//h4|//h5|//h6");

        if (textNodes != null)
        {
            foreach (var node in textNodes)
            {
                if (node.Name.Equals("li", StringComparison.OrdinalIgnoreCase))
                {
                    node.InnerHtml = "• " + node.InnerHtml + Environment.NewLine;
                }
                else
                {
                    node.InnerHtml += Environment.NewLine;
                }
            }
        }

        var text = WebUtility.HtmlDecode(doc.DocumentNode.InnerText);

        text = Regex.Replace(text, @"(\r?\n){3,}", Environment.NewLine + Environment.NewLine);

        return text.Trim();
    }

    // =========================
    // CONSOL Test
    // =========================
    private async Task DetectAndSetCountryAsync()
    {
        try
        {
            var culture = System.Globalization.CultureInfo.CurrentCulture;
            var region = new System.Globalization.RegionInfo(culture.Name);

            var code = region.TwoLetterISORegionName;
            var country = Countries.FirstOrDefault(x => x.Code == code);

            if (country == null) return;

            SelectedCountry = country.Code;

            // ✅ UPDATE METADATA
            Dictionary<string, object> metadata;

            try
            {
                metadata = string.IsNullOrWhiteSpace(Model.MetadataJson)
                    ? new Dictionary<string, object>()
                    : JsonSerializer.Deserialize<Dictionary<string, object>>(Model.MetadataJson)
                      ?? new Dictionary<string, object>();
            }
            catch
            {
                metadata = new Dictionary<string, object>();
            }

            metadata["CountryCode"] = country.Code;
            metadata["CountryName"] = country.Name;

            Model.MetadataJson = JsonSerializer.Serialize(metadata, new JsonSerializerOptions
            {
                WriteIndented = true
            });
        }
        catch
        {
            // silent
        }
    }

    // OCR Check
    private bool IsImageFile(string? fileName)
    {
        if (string.IsNullOrWhiteSpace(fileName))
            return true;

        var ext = Path.GetExtension(fileName).ToLowerInvariant();

        return ext switch
        {
            ".jpg" => true,
            ".jpeg" => true,
            ".png" => true,
            ".bmp" => true,
            ".tiff" => true,
            ".gif" => true,
            _ => false
        };
    }


}
