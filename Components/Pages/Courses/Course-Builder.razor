@page "/course-builder"
@layout MainLayout_NoRightPan
@attribute [Authorize(Roles = "Admin,SysAdmin")]

@using System.Text.Json.Nodes
@using System.Text
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Rendering
@using Radzen
@using MITANZ360Edu.Web.Services.AI;

@inject SharePointService SharePointService
@inject IWebHostEnvironment Env
@inject AIService AIService
@inject IConfiguration Configuration
@inject DialogService DialogService

<div class="app">

    <!-- ✅ DELETE MODAL -->
    @if (ShowDeleteConfirm)
    {
        <div class="overlay">
            <div class="confirm-box">
                <h3>Confirm Delete</h3>
                <p>Delete this course?</p>

                <div class="actions">
                    <RadzenButton Text="Cancel"
                                  Click="@((MouseEventArgs e) => CloseDeleteDialog())" />

                    <RadzenButton Text="Delete"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Click="@((MouseEventArgs e) => DeleteCourse())" />
                </div>
            </div>
        </div>
    }

    <!-- ✅ TOAST -->
    @if (ShowNotification)
    {
        <div class="toast">@SaveMessage</div>
    }

    <!-- ✅ HEADER -->
    <div class="header">

        <div class="left-header">
            <div class="title">AI Course Builder</div>

            <RadzenDropDown Data="@items"
                            TextProperty="Title"
                            ValueProperty="Id"
                            TValue="int?"
                            Value="@SelectedItemId"
                            ValueChanged="OnCourseChanged"
                            Style="min-width:200px;max-width:200px;width:200px;"
                            Placeholder="Select Course" />

            <RadzenDropDown Data="@PromptFiles"
                            @bind-Value="SelectedPrompt"
                            Style="min-width:200px;max-width:200px;width:200px;"
                            Placeholder="Select Prompt" />
        </div>

            <div class="actions">

            <RadzenButton Text="New" Icon="refresh" Click="@RefreshNew" Disabled="@IsGenerating" />

                <RadzenButton Icon="delete"
                              Text="Delete"
                              ButtonStyle="ButtonStyle.Danger"
                              Click="@((MouseEventArgs e) => ConfirmDelete())"
                              Disabled="@(SelectedItemId == null)" />

                <RadzenButton Icon="auto_awesome"
                              Text="@(IsGenerating ? "Generating..." : "AI Generate")"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@GenerateContentAsync"
                              Disabled="@(!SelectedItemId.HasValue || IsGenerating)"
                              Busy="@IsGenerating"
                              BusyText="🚀 Generating AI..." />

                <RadzenButton Text="Save" Click="@SaveJson" />

            </div>
    </div>

    <!-- ✅ TABS -->
    <div class="tabs">

        <!-- ✅ JSON TABS -->
        @foreach (var kv in JsonModel.Where(x => x.Key != "Summary"))
        {
            var key = kv.Key;

            <button class="tab @(ActiveTab == key ? "active" : "")"
                    @onclick="@(() => ActiveTab = key)">
                @key
            </button>
        }
        <!-- ✅ SUMMARY TAB (MANUAL)-->
        <button class="tab @(ActiveTab == "Summary" ? "active" : "")"
                @onclick="SetSummaryTab">
            AI-Feed
        </button>
    </div>


    <!-- ✅ FORM -->
    <div class="form-panel">
        @RenderActiveTab()
    </div>

</div>

<style>

    /* ✅ Come from AI */

    .ai-output .card {
        background: #ffffff !important;
        color: #1f1f1f !important;
    }

    .ai-output .card-body {
        background: #ffffff !important;
        color: #1f1f1f !important;
