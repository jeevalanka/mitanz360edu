                                </div>
                                <ul class="guide-list mb-0">
                                    @foreach (var item in panel.Items)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            </RadzenCard>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section id="permissions" class="section-gap section-muted">
            <div class="container-xxl">
                <div class="section-heading">
                    <span class="eyebrow">Permission Guide</span>
                    <h2 class="section-title">Who can perform CRUD actions</h2>
                    <p class="section-copy">The matrix communicates role expectations clearly and reinforces safe operational behavior for destructive and administrative actions.</p>
                </div>
                <div class="permission-shell">
                    <div class="table-responsive">
                        <table class="table permission-table mb-0">
                            <thead>
                                <tr>
                                    <th>Role</th>
                                    <th>Scope</th>
                                    <th class="text-center">Create</th>
                                    <th class="text-center">Read</th>
                                    <th class="text-center">Update</th>
                                    <th class="text-center">Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var role in Roles)
                                {
                                    <tr>
                                        <th>@role.Role</th>
                                        <td>@role.Scope</td>
                                        <td class="text-center"><span class="perm @(role.Create ? "yes" : "no")">@(role.Create ? "✓" : "—")</span></td>
                                        <td class="text-center"><span class="perm @(role.Read ? "yes" : "no")">@(role.Read ? "✓" : "—")</span></td>
                                        <td class="text-center"><span class="perm @(role.Update ? "yes" : "no")">@(role.Update ? "✓" : "—")</span></td>
                                        <td class="text-center"><span class="perm @(role.Delete ? "yes" : "no")">@(role.Delete ? "✓" : "—")</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>

        <section class="section-gap">
            <div class="container-xxl">
                <div class="row g-4 align-items-stretch">
                    <div class="col-12 col-lg-6">
