@page "/course-builder"
@layout MainLayout_NoRightPan

@using System.Text.Json.Nodes
@using System.Text
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Rendering
@using Radzen
@using MITANZ360Edu.Web.Services.AI;

@inject SharePointService SharePointService
@inject IWebHostEnvironment Env
@inject AIService AIService

<div class="app">

    <!-- ✅ DELETE MODAL -->
    @if (ShowDeleteConfirm)
    {
        <div class="overlay">
            <div class="confirm-box">
                <h3>Confirm Delete</h3>
                <p>Delete this course?</p>

                <div class="actions">
                    <RadzenButton Text="Cancel"
                                  Click="@((MouseEventArgs e) => CloseDeleteDialog())" />

                    <RadzenButton Text="Delete"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Click="@((MouseEventArgs e) => DeleteCourse())" />
                </div>
            </div>
        </div>
    }

    <!-- ✅ TOAST -->
    @if (ShowNotification)
    {
        <div class="toast">@SaveMessage</div>
    }

    <!-- ✅ HEADER -->
    <div class="header">

        <div class="left-header">
            <div class="title">AI Course Builder</div>

            <RadzenDropDown Data="@items"
                            TextProperty="Title"
                            ValueProperty="Id"
                            TValue="int?"
                            Value="@SelectedItemId"
                            ValueChanged="OnCourseChanged"
                            Style="width:100%"
                            Placeholder="Select Course" />
        </div>

        <div class="actions">
            <RadzenButton Text="New" Click="@LoadTemplate" />

            <RadzenButton Text="Save" Click="@SaveJson" />

            <RadzenButton Icon="delete"
                          Text="Delete"
                          ButtonStyle="ButtonStyle.Danger"
                          Click="@((MouseEventArgs e) => ConfirmDelete())"
                          Disabled="@(SelectedItemId == null)" />

            <RadzenButton Icon="auto_awesome"
                          Text="AI Generate"
                          ButtonStyle="ButtonStyle.Primary"
                          Click="@GenerateContentAsync"
                          Disabled="@(!SelectedItemId.HasValue || IsGenerating)"
                          Busy="@IsGenerating"
                          BusyText="Generating AI..." />
        </div>
    </div>

    <!-- ✅ TABS -->
    <div class="tabs">

        <!-- ✅ SUMMARY TAB (MANUAL) -->
        <button class="tab @(ActiveTab == "Summary" ? "active" : "")"
                @onclick="SetSummaryTab">
            Summary
        </button>

        <!-- ✅ JSON TABS -->
        @foreach (var kv in JsonModel.Where(x => x.Key != "Summary"))
        {
            var key = kv.Key;

            <button class="tab @(ActiveTab == key ? "active" : "")"
                    @onclick="@(() => ActiveTab = key)">
                @key
            </button>
        }

    </div>


    <!-- ✅ FORM -->
    <div class="form-panel">
        @RenderActiveTab()
    </div>

</div>

<style>

    /* ✅ ROOT */
    .app {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background: #f3f2f1;
        font-family: "Segoe UI";
    }

    /* ✅ HEADER */
    .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: nowrap;
        padding: 12px 16px;
        background: #008000;
        border-bottom: 1px solid #e1dfdd;
        gap: 16px;
    }

    .left-header {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1;
        min-width: 0;
    }

    .title {
        font-size: 24px;
        font-weight: 600;
        color: white;
        white-space: nowrap;
    }

    .left-header .rz-dropdown {
        width: 450px !important;
        max-width: 450px;
    }

    .actions {
        display: flex;
        gap: 10px;
        flex-shrink: 0;
    }

    /* ✅ TABS */
    .tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 10px;
        background: #fff;
    }

    .tab {
        padding: 6px 14px;
        border-radius: 16px;
        background: #e1dfdd;
        border: none;
    }

        .tab.active {
            background: #0078d4;
            color: white;
        }

    /* ✅ FORM GRID */
    .form-panel {
        padding: 16px;
    }

    /* ✅ KEY FIX — RESPONSIVE GRID */
    .group {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(350px,1fr));
        gap: 20px;
        align-items: start;
    }

    /* ✅ FIELD */
    .field {
        display: flex;
        flex-direction: column;
        width: 100%;
    }

    .field-label {
        min-height: 32px; /* force equal label height */
        font-weight: 600;
        margin-bottom: 6px;
    }

    /* ✅ FORCE FULL WIDTH */
    .rz-textbox,
    .rz-dropdown {
        width: 100% !important;
    }

    /* ✅ MODAL */
    .overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.4);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .confirm-box {
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        width: 300px;
    }

    /* ✅ TOAST */
    .toast {
        position: fixed;
        top: 20px;
        right: 20px;
        background: #28a745;
        color: white;
        padding: 10px;
        border-radius: 6px;
    }

    /* ✅ MOBILE */
    @@media(max - width:600px) {
        .group {
            grid-template-columns: 1fr;
        }
    }

</style>

@code {

    private List<AIRepositoryItem> items = new();
    private JsonObject JsonModel = new();
    private string ActiveTab = "";

    private int? SelectedItemId;

    private bool ShowDeleteConfirm;
    private bool ShowNotification;
    private string SaveMessage;
    private bool IsGenerating;

    private string SummaryText = "";
    private string HtmlContent = "";
    private string FileUrl = "";

    protected override async Task OnInitializedAsync()
    {
        items = await SharePointService.GetAIRepositoryItemsAsync(orderBy: "id desc");
        LoadTemplate();
    }

    private void OnCourseChanged(int? id)
    {
        SelectedItemId = id;

        if (id.HasValue)
        {
            var item = items.FirstOrDefault(x => x.Id == id);

            if (item != null)
            {
                // ✅ Load JSON model
                JsonModel = JsonNode.Parse(item.Metadata)?.AsObject() ?? new();

                // ✅ Default tab
                ActiveTab = JsonModel.FirstOrDefault().Key ?? "";

                // ✅ Summary
                SummaryText = item.Summary ?? "";

                // ✅ HTML REPORT (FINAL CLEAN LOGIC)
                if (string.IsNullOrWhiteSpace(item.HtmlReport))
                {
                    HtmlContent = "<p>No HTML content</p>";
                }
                else
                {
                    var content = item.HtmlReport.Trim();

                    if (content.StartsWith("{"))
                    {
                        // ✅ JSON → convert to rich HTML (one method only)
                        HtmlContent = ConvertJsonToRichHtml(content);
                    }
                    else
                    {
                        // ✅ already HTML
                        HtmlContent = content;
                    }
                }

                // ✅ File URL
                FileUrl = BuildFileUrl(item.Id);
            }
        }
    }

    private void LoadTemplate()
    {
        var path = Path.Combine(Env.WebRootPath, "Data", "template.json");

        JsonModel = JsonNode.Parse(File.ReadAllText(path))?.AsObject() ?? new();
        ActiveTab = JsonModel.FirstOrDefault().Key ?? "";

        SelectedItemId = null;
    }

    private async Task SaveJson()
    {
        try
        {
            var courseName =
                JsonModel?["CourseSetup"]?["CourseDetails"]?["CourseName"]?.ToString()
                ?? "Untitled";

            // ✅ ✅ --- NEW COURSE ---
            if (!SelectedItemId.HasValue)
            {
                await SharePointService.CreateAIRepositoryItemAsync(
                    new AIRepositoryItem
                    {
                        Title = courseName,
                        Metadata = JsonModel.ToJsonString(),
                        Summary = SummaryText,
                        HtmlReport = HtmlContent
                    });

                // ✅ IMPORTANT: Reload and grab latest item
                items = await SharePointService.GetAIRepositoryItemsAsync(orderBy: "id desc");

                var latestItem = items.FirstOrDefault();

                if (latestItem != null)
                {
                    SelectedItemId = latestItem.Id;
                    SaveMessage = "✅ New course created";
                }
                else
                {
                    SaveMessage = "❌ Create might have failed";
                }

                ShowNotification = true;
                await Task.Delay(2000);
                ShowNotification = false;

                return;
            }

            // ✅ ✅ --- EXISTING COURSE UPDATE ---
            var existingItem = items.FirstOrDefault(x => x.Id == SelectedItemId.Value);

            if (existingItem == null)
            {
                SaveMessage = "❌ Item not found";
                ShowNotification = true;
                return;
            }

            var oldName = existingItem.Title ?? "";

            // ✅ NAME CHANGE = CREATE NEW
            if (!string.Equals(oldName, courseName, StringComparison.OrdinalIgnoreCase))
            {
                await SharePointService.CreateAIRepositoryItemAsync(
                    new AIRepositoryItem
                    {
                        Title = courseName,
                        Metadata = JsonModel.ToJsonString(),
                        Summary = SummaryText,
                        HtmlReport = HtmlContent
                    });

                // ✅ Reload + select new item
                items = await SharePointService.GetAIRepositoryItemsAsync(orderBy: "id desc");

                var latestItem = items.FirstOrDefault();
                if (latestItem != null)
                {
                    SelectedItemId = latestItem.Id;
                }

                SaveMessage = "✅ New course created (renamed)";
            }
            else
            {
                await SharePointService.UpdateAIRepositoryItemAsync(
                    new AIRepositoryItem
                    {
                        Id = SelectedItemId.Value,
                        Title = courseName,
                        Metadata = JsonModel.ToJsonString(),
                        Summary = SummaryText,
                        HtmlReport = HtmlContent
                    });

                SaveMessage = "✅ Course updated";
            }

            ShowNotification = true;
            await Task.Delay(2000);
            ShowNotification = false;

            // ✅ Final refresh
            items = await SharePointService.GetAIRepositoryItemsAsync(orderBy: "id desc");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            SaveMessage = "❌ Save failed";
            ShowNotification = true;
        }
    }

    private void ConfirmDelete()
    {
        Console.WriteLine("✅ Confirm clicked");
        ShowDeleteConfirm = true;
    }

    private void CloseDeleteDialog()
    {
        ShowDeleteConfirm = false;
    }

    private async Task DeleteCourse()
    {
        if (!SelectedItemId.HasValue) return;

        Console.WriteLine($"Deleting {SelectedItemId}");

        await SharePointService.DeleteAIRepositoryItemAsync(SelectedItemId.Value);

        items = await SharePointService.GetAIRepositoryItemsAsync(orderBy: "id desc");

        LoadTemplate();

        SaveMessage = "🗑 Deleted";
        ShowNotification = true;

        ShowDeleteConfirm = false;

        await Task.Delay(2000);
        ShowNotification = false;
    }

    private RenderFragment RenderActiveTab() => builder =>
    {
        int seq = 0;

        // ✅ SUMMARY TAB
        if (ActiveTab == "Summary")
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "section");

            // ✅ SUMMARY TEXT
            builder.OpenElement(seq++, "h3");
            builder.AddContent(seq++, "Summary");
            builder.CloseElement();

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "summary-box");
            builder.AddContent(seq++, SummaryText ?? "No summary available");
            builder.CloseElement();

            // ✅ HTML REPORT HEADER
            builder.OpenElement(seq++, "h3");
            builder.AddAttribute(seq++, "style", "margin-top:20px;");
            builder.AddContent(seq++, "HTML Report");
            builder.CloseElement();

            // ✅ ✅ ✅ FIXED HTML RENDER (THIS IS THE IMPORTANT PART)
            builder.OpenElement(seq++, "div");

            builder.AddAttribute(seq++, "style",
                "background:#fff;" +
                "padding:10px;" +
                "border:1px solid #ddd;" +
                "max-height:400px;" +
                "overflow:auto;"
            );

            // 🔥 THIS LINE FIXES YOUR ISSUE
            builder.AddMarkupContent(seq++, HtmlContent ?? "<p>No content</p>");

            builder.CloseElement(); // end HTML container

            // ✅ FILE SECTION
            builder.OpenElement(seq++, "h3");
            builder.AddAttribute(seq++, "style", "margin-top:20px;");
            builder.AddContent(seq++, "AI Result File");
            builder.CloseElement();

            if (!string.IsNullOrEmpty(FileUrl))
            {
                builder.OpenElement(seq++, "a");
                builder.AddAttribute(seq++, "href", FileUrl);
                builder.AddAttribute(seq++, "target", "_blank");
                builder.AddContent(seq++, "📎 Download AI Result");
                builder.CloseElement();
            }
            else
            {
                builder.OpenElement(seq++, "p");
                builder.AddContent(seq++, "No file available");
                builder.CloseElement();
            }

            builder.CloseElement(); // end section
            return;
        }

        // ✅ JSON TABS (UNCHANGED)
        if (!JsonModel.ContainsKey(ActiveTab)) return;

        RenderNode(builder, ref seq, JsonModel[ActiveTab], JsonModel, ActiveTab);
    };
    private void RenderNode(RenderTreeBuilder builder, ref int seq, JsonNode node, JsonObject parent, string key)
    {
        // ✅ OBJECT
        if (node is JsonObject jsonObject)
        {
            // ✅ Dropdown FIRST
            if (jsonObject.ContainsKey("Value") && jsonObject.ContainsKey("Options"))
            {
                var currentValue = jsonObject["Value"]?.ToString();

                var dropdownOptions = jsonObject["Options"]?
                    .AsArray()
                    .Select(option => option?.ToString())
                    .Where(option => option != null)
                    .ToList() ?? new List<string>();

                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "field");

                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "field-label");
                builder.AddContent(seq++, key);
                builder.CloseElement();

                builder.OpenComponent<RadzenDropDown<string>>(seq++);
                builder.AddAttribute(seq++, "Data", dropdownOptions);
                builder.AddAttribute(seq++, "Value", currentValue);
                builder.AddAttribute(seq++, "Style", "width:100%");

                builder.AddAttribute(seq++, "Change",
                    EventCallback.Factory.Create<object>(this, value =>
                    {
                        jsonObject["Value"] = value?.ToString();
                    }));

                builder.CloseComponent();
                builder.CloseElement();
                return;
            }

            // ✅ NORMAL SECTION
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "section");

            builder.OpenElement(seq++, "h3");
            builder.AddContent(seq++, key);
            builder.CloseElement();

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "group");

            foreach (var property in jsonObject)
            {
                RenderNode(builder, ref seq, property.Value, jsonObject, property.Key);
            }

            builder.CloseElement(); // group
            builder.CloseElement(); // section
            return;
        }

        // ✅ ARRAY (FIXED + SAFE NAMING)
        else if (node is JsonArray jsonArrayNode)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "field");

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "field-label");
            builder.AddContent(seq++, key);
            builder.CloseElement();

            for (int i = 0; i < jsonArrayNode.Count; i++)
            {
                int currentIndex = i;

                builder.OpenComponent<RadzenTextBox>(seq++);
                builder.AddAttribute(seq++, "Value", jsonArrayNode[currentIndex]?.ToString());
                builder.AddAttribute(seq++, "Style", "margin-bottom:6px;width:100%");

                builder.AddAttribute(seq++, "Change",
                    EventCallback.Factory.Create<string>(this, newValue =>
                    {
                        jsonArrayNode[currentIndex] = newValue;
                    }));

                builder.CloseComponent();
            }

            builder.CloseElement();
            return;
        }

        // ✅ VALUE
        else if (node is JsonValue jsonValueNode)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "field");

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "field-label");
            builder.AddContent(seq++, key);
            builder.CloseElement();

            builder.OpenComponent<RadzenTextBox>(seq++);
            builder.AddAttribute(seq++, "Value", jsonValueNode.ToString());
            builder.AddAttribute(seq++, "Style", "width:100%");

            builder.AddAttribute(seq++, "Change",
                EventCallback.Factory.Create<string>(this, newValue =>
                {
                    parent[key] = newValue;
                }));

            builder.CloseComponent();
            builder.CloseElement();
        }
    }

    private async Task GenerateContentAsync()
    {
        try
        {
            IsGenerating = true;

            SaveMessage = "🤖 Generating content...";
            ShowNotification = true;

            var response = await AIService.GenerateCourseContentAsync(
                JsonModel.ToJsonString());

            if (response != null)
            {
                // ✅ Update UI JSON
                if (!string.IsNullOrWhiteSpace(response.Json))
                {
                    var newJson = JsonNode.Parse(response.Json)?.AsObject();
                    if (newJson != null)
                    {
                        JsonModel = newJson;
                        ActiveTab = JsonModel.FirstOrDefault().Key ?? "";
                    }
                }

                // ✅ UPDATE SHAREPOINT ITEM
                if (SelectedItemId.HasValue)
                {
                    await SharePointService.UpdateAIFieldsAndAttachFileAsync(
                        SelectedItemId.Value,
                        response);
                }

                StateHasChanged();

                SaveMessage = "✅ AI content generated & saved!";
            }
            else
            {
                SaveMessage = "⚠ No AI response";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            SaveMessage = "❌ AI generation failed";
        }
        finally
        {
            IsGenerating = false;

            await Task.Delay(2500);
            ShowNotification = false;
        }
    }

    private string BuildFileUrl(int itemId)
    {
        // ✅ Adjust your tenant URL
        var baseUrl = "https://mitga.sharepoint.com/sites/MITANZ360Edu";
        return $"{baseUrl}/AI_Result_{itemId}";
    }

    private void SetSummaryTab()
    {
        ActiveTab = "Summary";
    }

    private string ConvertJsonToRichHtml(string json)
    {
        try
        {
            var root = JsonNode.Parse(json)?.AsObject();

            if (root == null)
                return "<p>No content available</p>";

            var html = new System.Text.StringBuilder();

            html.Append("<div style='font-family:Segoe UI; line-height:1.6;'>");

            foreach (var section in root)
            {
                html.Append($"<h2 style='color:#0078d4;border-bottom:1px solid #ddd;padding-bottom:4px;'>{section.Key}</h2>");

                if (section.Value is JsonObject obj)
                {
                    foreach (var field in obj)
                    {
                        html.Append("<div style='margin-bottom:10px;'>");

                        html.Append($"<strong style='color:#333'>{field.Key}:</strong><br/>");

                        if (field.Value is JsonObject nested)
                        {
                            foreach (var sub in nested)
                            {
                                html.Append($"<div style='margin-left:15px'>• {sub.Key}: {sub.Value}</div>");
                            }
                        }
                        else
                        {
                            html.Append($"<span>{field.Value}</span>");
                        }

                        html.Append("</div>");
                    }
                }

                html.Append("<br/>");
            }

            html.Append("</div>");

            return html.ToString();
        }
        catch
        {
            return $"<pre>{System.Net.WebUtility.HtmlEncode(json)}</pre>";
        }
    }
    private void AppendField(StringBuilder sb, string label, JsonNode value)
    {
        sb.Append($@"
        <div style='display:flex; justify-content:space-between; padding:6px 0; border-bottom:1px solid #f2f2f2;'>
            <span style='font-weight:500'>{label}</span>
            <span>{value}</span>
        </div>
    ");
    }


}