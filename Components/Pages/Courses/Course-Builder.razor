@code {
    private List<AIRepositoryItem> items = new();
    private JsonObject JsonModel = new();
    private string ActiveTab = "";

    private int? SelectedItemId;

    private bool ShowDeleteConfirm;
    private bool ShowNotification;
    private string SaveMessage;
    private bool IsGenerating;

    private string SummaryText = "";
    private string HtmlContent = "";
    private string FileUrl = "";

    private string OriginalMetadata = "";

    private List<string> PromptFiles = new();
    private string SelectedPrompt = "";
    private bool isGenerating = false;
    private string aiStatusMessage = "";

    protected override async Task OnInitializedAsync()
    {
        items = await SharePointService.GetAIRepositoryItemsAsync(orderBy: "id desc");
        LoadPromptFiles();
        await RefreshNew();
    }

    private void OnCourseChanged(int? id)
    {
        SelectedItemId = id;

        if (!id.HasValue)
            return;

        var item = items.FirstOrDefault(x => x.Id == id);

        if (item == null)
        {
            Console.WriteLine("❌ Item not found");
            return;
        }

        Console.WriteLine($"✅ Loading Item ID: {item.Id}");

        try
        {
            // ✅ Keep original metadata safe
            OriginalMetadata = item.Metadata ?? "";

            if (!string.IsNullOrWhiteSpace(item.Metadata))
            {
                var parsed = JsonNode.Parse(item.Metadata)?.AsObject();

                if (parsed != null)
                {
                    JsonModel = parsed;

                    Console.WriteLine($"✅ Metadata loaded ({item.Metadata.Length} chars)");
                }
                else
                {
                    Console.WriteLine("⚠ Metadata parsed as null - keeping existing JsonModel");
                }
            }
            else
            {
                Console.WriteLine("⚠ Metadata is empty - keeping existing JsonModel");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("❌ Metadata parse failed");
            Console.WriteLine(ex.Message);

            // ✅ Never clear JsonModel
            // ✅ Never load template here
            // ✅ Never overwrite OriginalMetadata
        }

        ActiveTab = JsonModel?.FirstOrDefault().Key ?? "";

        SummaryText = item.Summary ?? "";

        SelectedPrompt = item.Tags?.Trim() ?? "";

        HtmlContent = string.IsNullOrWhiteSpace(item.HtmlReport)
            ? "<p>No HTML content</p>"
            : $@"<div style='background:#fff;padding:20px'>
                {SanitizeHtml(item.HtmlReport)}
            </div>";

        FileUrl = BuildFileUrl(item.Id);

        StateHasChanged();
    }

    private async Task SaveJson()
    {
        try
        {
            var courseName =
                JsonModel?["CourseSetup"]?["CourseDetails"]?["CourseName"]?.ToString()
                ?? "Untitled";

            // ✅ Never allow null / empty metadata
            var metadata =
                JsonModel != null && JsonModel.Count > 0
                    ? JsonModel.ToJsonString()
                    : OriginalMetadata;

            if (string.IsNullOrWhiteSpace(metadata))
            {
                SaveMessage = "❌ Metadata cannot be empty";
                ShowNotification = true;
                return;
            }

            if (!SelectedItemId.HasValue)
            {
                // ✅ NEW RECORD
                await SharePointService.CreateAIRepositoryItemAsync(
                    new AIRepositoryItem
                    {
                        Title = courseName,
                        Metadata = metadata,
                        HtmlReport = HtmlContent,
                        Summary = SummaryText,
                        Tags = SelectedPrompt,
                        Status = "Pending",
                        Score = CalculateScore(HtmlContent)
                    });

                items = await SharePointService.GetAIRepositoryItemsAsync(orderBy: "id desc");

                SelectedItemId = items.FirstOrDefault()?.Id;

                // ✅ Keep latest metadata snapshot
                OriginalMetadata = metadata;

                SaveMessage = "✅ New course created";
            }
            else
            {
                // ✅ EXISTING RECORD
                await SharePointService.UpdateAIRepositoryItemAsync(
                    new AIRepositoryItem
                    {
                        Id = SelectedItemId.Value,
                        Title = courseName,
                        Metadata = metadata,
                        Summary = SummaryText,
                        HtmlReport = HtmlContent,
                        Tags = SelectedPrompt
                    });

                // ✅ Refresh backup after successful save
                OriginalMetadata = metadata;

                SaveMessage = "✅ Course updated";
            }

            ShowNotification = true;

            await Task.Delay(2000);

            ShowNotification = false;

            items = await SharePointService.GetAIRepositoryItemsAsync(orderBy: "id desc");
        }
        catch (Exception ex)
        {
            Console.WriteLine("❌ Save Error");
            Console.WriteLine(ex);

            SaveMessage = "❌ Save failed";
            ShowNotification = true;
        }
    }

    private void ConfirmDelete()
    {
        Console.WriteLine("✅ Confirm clicked");
        ShowDeleteConfirm = true;
    }

    private void CloseDeleteDialog()
    {
        ShowDeleteConfirm = false;
    }

    private async Task DeleteCourse()
    {
        if (!SelectedItemId.HasValue) return;

        Console.WriteLine($"Deleting {SelectedItemId}");

        await SharePointService.DeleteAIRepositoryItemAsync(SelectedItemId.Value);

        items = await SharePointService.GetAIRepositoryItemsAsync(orderBy: "id desc");

        await RefreshNew();
        SaveMessage = "🗑 Deleted";
        ShowNotification = true;

        ShowDeleteConfirm = false;

        await Task.Delay(2000);
        ShowNotification = false;
    }

    private RenderFragment RenderActiveTab() => builder =>
    {
        int seq = 0;

        // ✅ SUMMARY TAB
        if (ActiveTab == "Summary")
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "section");

            // ✅ HEADER
            builder.OpenElement(seq++, "h3");
            builder.AddAttribute(seq++, "style", "margin-top:18px; color:darkorange;");
            builder.AddContent(seq++, "Summary");
            builder.CloseElement();

            // ✅ SUMMARY TEXT
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "summary-box");
            builder.AddContent(seq++, SummaryText ?? "No summary available");
            builder.CloseElement();

            // ✅ SCORE + TAGS
            var score = CalculateScore(HtmlContent);

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "style",
                $"margin-top:10px;" +
                "padding:10px;" +
                "border-radius:6px;" +
                $"background:{(score > 80 ? "#d4edda" : score > 60 ? "#fff3cd" : "#f8d7da")};" +
                "border:1px solid #ddd;"
            );

            // ✅ SCORE
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "style", "font-weight:600;");
            builder.AddContent(seq++, $"Score: {score}");
            builder.CloseElement();

            // ✅ TAGS
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "style", "margin-top:6px;");
            builder.AddContent(seq++, $"Tags: {SelectedPrompt}");
            builder.CloseElement();

            builder.CloseElement(); // ✅ CLOSE SCORE BOX

            // ✅ REPORT HEADER
            builder.OpenElement(seq++, "h3");
            builder.AddAttribute(seq++, "style", "margin-top:18px; color:darkorange;");
            builder.AddContent(seq++, "Report");
            builder.CloseElement();

            // ✅ HTML RENDER
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "style",
                "background:#fff;" +
                "padding:10px;" +
                "border:1px solid #ddd;" +
                "max-height:400px;" +
                "overflow:auto;"
            );

            builder.AddMarkupContent(seq++, SanitizeHtml(HtmlContent));

            builder.CloseElement(); // ✅ CLOSE HTML BOX

            // ✅ FILE HEADER
            builder.OpenElement(seq++, "h3");
            builder.AddAttribute(seq++, "style", "margin-top:18px; color:darkorange;");
            builder.AddContent(seq++, "Att: File");
            builder.CloseElement();

            // ✅ FILE LINK
            if (!string.IsNullOrEmpty(FileUrl))
            {
                builder.OpenElement(seq++, "a");
                builder.AddAttribute(seq++, "href", FileUrl);
                builder.AddAttribute(seq++, "target", "_blank");
                builder.AddContent(seq++, "📎 Download AI Result");
                builder.CloseElement();
            }
            else
            {
                builder.OpenElement(seq++, "p");
                builder.AddContent(seq++, "No file available");
                builder.CloseElement();
            }

            builder.CloseElement(); // ✅ CLOSE MAIN SECTION

            return;
        }

        // ✅ JSON TABS
        if (!JsonModel.ContainsKey(ActiveTab))
            return;

        RenderNode(builder, ref seq, JsonModel[ActiveTab], JsonModel, ActiveTab);
    };

    private void RenderNode(RenderTreeBuilder builder, ref int seq, JsonNode node, JsonObject parent, string key)
    {
        // ✅ OBJECT
        if (node is JsonObject jsonObject)
        {
            // ✅ Dropdown FIRST
            if (jsonObject.ContainsKey("Value") && jsonObject.ContainsKey("Options"))
            {
                var currentValue = jsonObject["Value"]?.ToString();

                var dropdownOptions = jsonObject["Options"]?
                    .AsArray()
                    .Select(option => option?.ToString())
                    .Where(option => option != null)
                    .ToList() ?? new List<string>();

                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "field");

                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "field-label");
                builder.AddContent(seq++, key);
                builder.CloseElement();

                builder.OpenComponent<RadzenDropDown<string>>(seq++);
                builder.AddAttribute(seq++, "Data", dropdownOptions);
                builder.AddAttribute(seq++, "Value", currentValue);
                builder.AddAttribute(seq++, "Style", "width:100%");

                builder.AddAttribute(seq++, "Change",
                    EventCallback.Factory.Create<object>(this, value =>
                    {
                        jsonObject["Value"] = value?.ToString();
                    }));

                builder.CloseComponent();
                builder.CloseElement();
                return;
            }

            // ✅ NORMAL SECTION
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "section");

            builder.OpenElement(seq++, "h3");
            builder.AddContent(seq++, key);
            builder.CloseElement();

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "group");

            foreach (var property in jsonObject)
            {
                RenderNode(builder, ref seq, property.Value, jsonObject, property.Key);
            }

            builder.CloseElement(); // group
            builder.CloseElement(); // section
            return;
        }

        // ✅ ARRAY (FIXED + SAFE NAMING)
        else if (node is JsonArray jsonArrayNode)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "field");

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "field-label");
            builder.AddContent(seq++, key);
            builder.CloseElement();

            for (int i = 0; i < jsonArrayNode.Count; i++)
            {
                int currentIndex = i;

                builder.OpenComponent<RadzenTextBox>(seq++);
                builder.AddAttribute(seq++, "Value", jsonArrayNode[currentIndex]?.ToString());
                builder.AddAttribute(seq++, "Style", "margin-bottom:6px;width:100%");

                builder.AddAttribute(seq++, "Change",
                    EventCallback.Factory.Create<string>(this, newValue =>
                    {
                        jsonArrayNode[currentIndex] = newValue;
                    }));

                builder.CloseComponent();
            }

            builder.CloseElement();
            return;
        }

        // ✅ VALUE
        else if (node is JsonValue jsonValueNode)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "field");

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "field-label");
            builder.AddContent(seq++, key);
            builder.CloseElement();

            builder.OpenComponent<RadzenTextBox>(seq++);
            builder.AddAttribute(seq++, "Value", jsonValueNode.ToString());
            builder.AddAttribute(seq++, "Style", "width:100%");

            builder.AddAttribute(seq++, "Change",
                EventCallback.Factory.Create<string>(this, newValue =>
                {
                    parent[key] = newValue;
                }));

            builder.CloseComponent();
            builder.CloseElement();
        }
    }

    private async Task GenerateContentAsync()
    {
        try
        {
            // ✅ Save current JSON first
            if (SelectedItemId.HasValue)
            {
                await SaveJson();
            }

            IsGenerating = true;
            SaveMessage = "🤖 Generating content...";
            ShowNotification = true;

            await InvokeAsync(StateHasChanged);
            await Task.Yield();

            var response = await AIService.GenerateContentAsync(
                JsonModel,
                SelectedPrompt
            );

            if (response == null)
            {
                SaveMessage = "⚠ No AI response";
                return;
            }

            SaveMessage = "🧠 Processing AI response...";
            await InvokeAsync(StateHasChanged);

            HtmlContent = response.Html ?? "";


            SummaryText = GenerateSummary(HtmlContent);

            if (SelectedItemId.HasValue)
            {

                var aiResult = new AIResultDto
                {
                    Html = HtmlContent,
                    Summary = SummaryText,
                    Tags = SelectedPrompt,
                    // ✅ REMOVE Metadata COMPLETELY
                    Score = CalculateScore(HtmlContent)
                };

                await SharePointService.UpdateAIFieldsAsync(
                    SelectedItemId.Value,
                    aiResult,
                    SelectedPrompt,
                    CancellationToken.None
                );
            }

            SaveMessage = "✅ AI content generated & saved!";
        }
        catch (Exception ex)
        {
            Console.WriteLine("❌ AI ERROR:");
            Console.WriteLine(ex);

            SaveMessage = "❌ AI generation failed";
        }
        finally
        {
            IsGenerating = false;

            await Task.Delay(1500);
            ShowNotification = false;

            await InvokeAsync(StateHasChanged);
        }
    }

    private string BuildFileUrl(int itemId)
    {
        var baseUrl = Configuration["SharePoint:BaseUrl"];

        if (string.IsNullOrWhiteSpace(baseUrl))
        {
            Console.WriteLine("❌ SharePoint BaseUrl missing in appsettings");
            return string.Empty;
        }

        return $"{baseUrl}/AI_Result_{itemId}";
    }

    private void SetSummaryTab()
    {
        ActiveTab = "Summary";
    }

    private string ConvertJsonToRichHtml(string json)
    {
        try
        {
            var root = JsonNode.Parse(json)?.AsObject();

            if (root == null)
                return "<p>No content available</p>";

            var html = new System.Text.StringBuilder();

            html.Append("<div style='font-family:Segoe UI; line-height:1.6;'>");

            foreach (var section in root)
            {
                html.Append($"<h2 style='color:#0078d4;border-bottom:1px solid #ddd;padding-bottom:4px;'>{section.Key}</h2>");

                if (section.Value is JsonObject obj)
                {
                    foreach (var field in obj)
                    {
                        html.Append("<div style='margin-bottom:10px;'>");

                        html.Append($"<strong style='color:#333'>{field.Key}:</strong><br/>");

                        if (field.Value is JsonObject nested)
                        {
                            foreach (var sub in nested)
                            {
                                html.Append($"<div style='margin-left:15px'>• {sub.Key}: {sub.Value}</div>");
                            }
                        }
                        else
                        {
                            html.Append($"<span>{field.Value}</span>");
                        }

                        html.Append("</div>");
                    }
                }

                html.Append("<br/>");
            }

            html.Append("</div>");

            return html.ToString();
        }
        catch
        {
            return $"<pre>{System.Net.WebUtility.HtmlEncode(json)}</pre>";
        }
    }

    private void AppendField(StringBuilder sb, string label, JsonNode value)
    {
        sb.Append($@"
        <div style='display:flex; justify-content:space-between; padding:6px 0; border-bottom:1px solid #f2f2f2;'>
            <span style='font-weight:500'>{label}</span>
            <span>{value}</span>
        </div>
    ");
    }

    private async Task RefreshNew()
    {
        try
        {
            Console.WriteLine("✅ NEW COURSE INITIALIZED");

            SelectedItemId = null;

            SummaryText = "";
            HtmlContent = "";
            FileUrl = "";

            items = await SharePointService.GetAIRepositoryItemsAsync(orderBy: "id desc");

            // ✅ ONLY PLACE WHERE TEMPLATE IS ALLOWED
            var path = Path.Combine(
                Env.WebRootPath,
                "Data",
                "template.json");

            JsonModel =
                JsonNode.Parse(File.ReadAllText(path))?.AsObject()
                ?? new JsonObject();

            // ✅ KEEP TEMPLATE AS BACKUP METADATA
            OriginalMetadata = JsonModel.ToJsonString();

            Console.WriteLine(
                $"✅ Template metadata loaded ({OriginalMetadata.Length} chars)");

            ActiveTab = JsonModel.FirstOrDefault().Key ?? "";

            SaveMessage = "🆕 New course template loaded";
            ShowNotification = true;

            await Task.Delay(1500);

            ShowNotification = false;

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine("❌ New template load failed");
            Console.WriteLine(ex);

            SaveMessage = "❌ New template load failed";
            ShowNotification = true;
        }
    }

    private void LoadPromptFiles()
    {
        var promptFolder =
            Path.Combine(
                Env.WebRootPath,
                "Data",
                "Prompts");

        if (!Directory.Exists(promptFolder))
            return;

        PromptFiles = Directory
            .GetFiles(promptFolder, "*.txt")
            .Select(Path.GetFileNameWithoutExtension)
            .OrderBy(x => x)
            .ToList();

        SelectedPrompt =
            PromptFiles.FirstOrDefault() ?? "";
    }

    private string SanitizeHtml(string html)
    {
        if (string.IsNullOrWhiteSpace(html))
            return "";

        var clean = html;

        // ✅ Decode SharePoint encoding
        try
        {
            clean = System.Text.Json.JsonSerializer.Deserialize<string>($"\"{clean}\"") ?? clean;
            clean = System.Net.WebUtility.HtmlDecode(clean);
        }
        catch { }

        // ✅ REMOVE ExternalClass
        clean = System.Text.RegularExpressions.Regex.Replace(
            clean,
            @"ExternalClass[^\s""]*",
            "",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase
        );

        // ✅ REMOVE Bootstrap card + dark styles (MAIN FIX)
        clean = System.Text.RegularExpressions.Regex.Replace(
            clean,
            @"\b(card|card-body|shadow-sm|mb-\d+|bg-dark|text-white)\b",
            "",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase
        );

        // ✅ FORCE WHITE BACKGROUND
        clean = System.Text.RegularExpressions.Regex.Replace(
            clean,
            @"background\s*:\s*[^;]+;",
            "background:white;",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase
        );

        return clean;
    }

    private string CleanHtml(string html)
    {
        if (string.IsNullOrWhiteSpace(html)) return "";

        var clean = html;

        // ✅ Remove SharePoint ExternalClass
        clean = System.Text.RegularExpressions.Regex.Replace(
            clean,
            @"class=""ExternalClass[^""]*""",
            "",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase
        );

        // ✅ Remove Bootstrap card classes completely
        clean = clean.Replace("card", "")
                     .Replace("card-body", "")
                     .Replace("shadow-sm", "")
                     .Replace("mb-4", "");

        return clean;
    }

    private string GenerateSummary(string html)
    {
        if (string.IsNullOrWhiteSpace(html)) return "";

        // ✅ Remove HTML tags
        var text = System.Text.RegularExpressions.Regex.Replace(html, "<.*?>", " ");

        // ✅ Trim + limit
        text = text.Trim();

        if (text.Length > 200)
            text = text.Substring(0, 200) + "...";

        return text;
    }

    private decimal CalculateScore(string html)
    {
        if (string.IsNullOrWhiteSpace(html)) return 0;

        decimal score = 50;

        if (html.Contains("<table")) score += 15;
        if (html.Contains("<ul")) score += 10;
        if (html.Contains("<h2")) score += 10;
        if (html.Length > 1000) score += 15;

        return Math.Min(score, 100);
    }


