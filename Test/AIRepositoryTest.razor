@page "/ai-repository-test"

@using Radzen
@using MITANZ360Edu.Web.Services

@inject SharePointService SharePointService
@inject NotificationService NotificationService

<h3 class="page-title">📊 AI Repository Test Console</h3>

<div class="filter-panel">

    <div class="row">
        <input placeholder="Status"
               @bind="status" />

        <input placeholder="Entity Type"
               @bind="entityType" />

        <input type="number"
               placeholder="Min Score"
               @bind="minScore" />

        <input placeholder="Search..."
               @bind="search" />

        <select @bind="orderBy">
            <option value="fields/Created desc">Newest</option>
            <option value="fields/Score desc">Score High → Low</option>
            <option value="fields/Score asc">Score Low → High</option>
        </select>

        <button @onclick="LoadData">
            🔍 Search
        </button>
    </div>
</div>

@if (isLoading)
{
    <p>Loading data...</p>
}
else if (items != null)
{
    <RadzenGrid Data="@items"
                TItem="AIRepositoryItem"
                AllowPaging="true"
                PageSize="10"
                AllowSorting="true"
                AllowFiltering="false">
        <Columns>
            <RadzenGridColumn TItem="AIRepositoryItem" Property="Id" Title="ID" Width="80px" />
            <RadzenGridColumn TItem="AIRepositoryItem" Property="Title" Title="Title" />
            <RadzenGridColumn TItem="AIRepositoryItem" Property="EntityType" Title="Type" />
            <RadzenGridColumn TItem="AIRepositoryItem" Property="Score" Title="Score" />
            <RadzenGridColumn TItem="AIRepositoryItem" Property="Status" Title="Status" />
            <RadzenGridColumn TItem="AIRepositoryItem" Property="Summary" Title="Summary" />
        </Columns>
    </RadzenGrid>

    <p>Total Records: @items.Count</p>
}

<style>
.page-title {
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 15px;
}

.filter-panel {
    padding: 15px;
    margin-bottom: 15px;
    backdrop-filter: blur(10px);
    background: rgba(255,255,255,0.1);
    border-radius: 10px;
}

.row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

input, select {
    padding: 6px;
    border-radius: 6px;
}

button {
    background: #0078d4;
    color: white;
    border: none;
    padding: 6px 12px;
    border-radius: 6px;
}
</style>

@code {

    private List<AIRepositoryItem>? items;

    private bool isLoading;

    // ✅ Filters
    private string? status;
    private string? entityType;
    private decimal? minScore;
    private string? search;
    private string? orderBy = "fields/Created desc";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;

            items = await SharePointService
                .GetAIRepositoryItemsAsync(
                    status,
                    entityType,
                    minScore,
                    search,
                    orderBy);

            NotificationService.Notify(new Radzen.NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Loaded",
                Detail = $"Loaded {items.Count} records",
                Duration = 3000
            });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new Radzen.NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = ex.Message,
                Duration = 4000
            });
        }
        finally
        {
            isLoading = false;
        }
    }
}