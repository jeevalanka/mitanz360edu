@page "/model-content"
@layout MainLayout_NoRightPan

@using MITANZ360Edu.Web.Models
@using MITANZ360Edu.Web.Services
@using Radzen
@using Radzen.Blazor

@inject ModelContentService ModelContentService
@inject SharePointService SharePointService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject ILogger<ModelContent> Logger

<PageTitle>Model Content</PageTitle>

<div class="mc-shell">

    <div class="mc-main-grid">

        <!-- LEFT -->
        <div class="mc-card">

            <div class="mc-card-header">

                <div class="mc-title">Content Management</div>

                <div class="mc-subtitle">
                    Enterprise educational content records
                </div>

                <div class="mc-toolbar">

                    <RadzenTextBox @bind-Value="_search"
                                   Placeholder="Search content..."
                                   Style="width:260px;" />

                    <RadzenDropDown @bind-Value="_filterPublished"
                                    Data="@_publishFilters"
                                    Style="width:180px;" />

                    <RadzenDropDown TValue="string"
                                    Data="@_contentTypes"
                                    TextProperty="Title"
                                    ValueProperty="Code"
                                    @bind-Value="_filterContentType"
                                    Placeholder="Content Type"
                                    Style="width:220px;" />

                    <RadzenButton Text="Refresh"
                                  Icon="refresh"
                                  Click="@LoadAsync" />

                    <RadzenButton Text="New Content"
                                  Icon="add_circle"
                                  Click="@CreateNew"
                                  Style="background:#ff6b35;border:none;" />

                </div>

            </div>

            <div class="mc-grid-wrapper">

                <RadzenDataGrid TItem="ModelContentModel"
                                Data="@FilteredItems"
                                AllowPaging="true"
                                PageSize="10">

                    <Columns>

                        <RadzenDataGridColumn Property="Title" Title="Title" />

                        <RadzenDataGridColumn Property="CourseId" Title="Course ID" />

                        <RadzenDataGridColumn Property="ModuleNo" Title="Module" />

                        <RadzenDataGridColumn Title="Type">
                            <Template Context="item">
                                <span class="mc-type-pill">
                                    @GetContentTypeTitle(item.ContentTypeCode)
                                </span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Title="Status">
                            <Template Context="item">
                                <span class="mc-status-pill @(item.IsPublished ? "mc-published" : "mc-draft")">
                                    @(item.IsPublished ? "Published" : "Draft")
                                </span>
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Title="Actions">
                            <Template Context="item">
                                <div class="mc-actions">

                                    <RadzenButton Icon="visibility"
                                                  Click="@(() => SelectView(item))" />

                                </div>
                            </Template>
                        </RadzenDataGridColumn>

                    </Columns>

                </RadzenDataGrid>

            </div>

        </div>

        <!-- RIGHT -->
        <div class="mc-card">

            <div class="mc-card-header">
                <div class="mc-title">Content Editor</div>
            </div>

            <div class="mc-editor">

                @if (_selected == null)
                {
                    <div>Select or create content.</div>
                }
                else
                {
                    <RadzenTemplateForm TItem="ModelContentModel"
                                        Data="@_selected"
                                        Submit="@SaveAsync">

                        <RadzenTabs>

                            <Tabs>

                                <RadzenTabsItem Text="General">

                                    <RadzenTextBox @bind-Value="_selected.Title"
                                                   Style="width:100%;" />

                                    <RadzenDropDown Data="@_courses"
                                                    TextProperty="CourseCode"
                                                    ValueProperty="CourseCode"
                                                    @bind-Value="_selected.CourseId"
                                                    Style="width:100%;" />

                                    <RadzenTextBox @bind-Value="_selected.ModuleNo"
                                                   Style="width:100%;" />

                                    <!-- ✅ FIXED DROPDOWN -->
                                    <RadzenDropDown TValue="string"
                                                    Data="@_contentTypes"
                                                    TextProperty="Title"
                                                    ValueProperty="Code"
                                                    @bind-Value="_selected.ContentTypeCode"
                                                    Style="width:100%;" />

                                    <RadzenNumeric @bind-Value="_selected.DurationMinutes"
                                                   Style="width:100%;" />

                                </RadzenTabsItem>

                            </Tabs>

                        </RadzenTabs>

                        <RadzenButton Text="Save"
                                      ButtonType="ButtonType.Submit" />

                    </RadzenTemplateForm>
                }

            </div>

        </div>

    </div>

</div>

@code {

    private List<ModelContentModel> _items = new();
    private List<ReferenceDataItem> _contentTypes = new();
    private IReadOnlyList<CourseModel> _courses = new List<CourseModel>();

    private ModelContentModel? _selected;

    private string _search = "";
    private string _filterPublished = "All";
    private string? _filterContentType;

    private readonly List<string> _publishFilters =
    [
        "All",
        "Published",
        "Draft"
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _items = await ModelContentService.GetAllAsync();

            _courses = await SharePointService.GetCoursesAsync();

            _contentTypes = await SharePointService
                .GetReferenceDataByCategoryAsync("LMS", "ContentType");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Load failed");

            NotificationService.Notify(
                NotificationSeverity.Error,
                "Error",
                ex.Message);
        }
    }

    private IEnumerable<ModelContentModel> FilteredItems =>
        _items
            .Where(x =>
                string.IsNullOrWhiteSpace(_search)
                || (x.Title ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase))
            .Where(x =>
                string.IsNullOrWhiteSpace(_filterContentType)
                || x.ContentTypeCode == _filterContentType)
            .Where(x =>
                _filterPublished == "All"
                || (_filterPublished == "Published" && x.IsPublished)
                || (_filterPublished == "Draft" && !x.IsPublished));

    private void CreateNew()
    {
        _selected = new ModelContentModel();
    }

    private void SelectView(ModelContentModel item)
    {
        _selected = item;
    }

    private async Task SaveAsync()
    {
        if (_selected == null) return;

        var ok = _selected.Id == 0
            ? await ModelContentService.CreateAsync(_selected)
            : await ModelContentService.UpdateAsync(_selected);

        if (ok)
        {
            NotificationService.Notify(NotificationSeverity.Success, "Saved", "Success");
            await LoadAsync();
        }
    }

    // ✅ TITLE MAPPING FIX
    private string GetContentTypeTitle(string? code)
    {
        if (string.IsNullOrWhiteSpace(code))
            return "N/A";

        var match = _contentTypes
            .FirstOrDefault(x => x.Code == code);

        return match?.Title ?? code;
    }
}