        new("Browse Library", "fa-solid fa-table-cells-large", "#overview"),
        new("Search Content", "fa-solid fa-magnifying-glass", "#guide"),
        new("Recent Documents", "fa-solid fa-file-lines", "#quick-start"),
        new("AI Assistant", "fa-solid fa-brain", "#ai-features")
    ];

    private readonly IReadOnlyList<MetricCard> HeroMetrics =
    [
        new("Knowledge Assets", "12,480+", "fa-solid fa-book-open-reader", "Course notes, job aids, guides, decks, media, and governed learning references."),
        new("Active Learning Paths", "320", "fa-solid fa-folder-tree", "Structured journeys grouped by academy, course, module, and lesson."),
