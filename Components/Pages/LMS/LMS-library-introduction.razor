                                            <div>
                                                <h3 class="h6 mb-1">@item.Title</h3>
                                                <p class="mb-0 small-panel-copy">@item.Description</p>
                                            </div>
                                        </div>
                                    </RadzenCard>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="section-heading mb-3">
                            <span class="eyebrow">Microsoft Integration</span>
                            <h2 class="section-title">Aligned to the approved MITANZ360Edu stack</h2>
